  <div class="bk-specs__tablewrap">
    <table class="bk-specs__table">
      <thead>
        <tr>
          <th scope="col">Part #</th>
          <th scope="col">Size (in.)</th>
          <th scope="col">L (in.)</th>
          <th scope="col">W (in.)</th>
          <th scope="col">H (in.)</th>
          <th scope="col">Capacity</th>
          <th scope="col">Weight</th>
          <th scope="col">Price</th>
          <th scope="col" class="bk-specs__buycell">Order</th>
        </tr>
      </thead>
      <tbody>
        {%- for r in rows -%}
          {%- assign c = r | split: '|' -%}
          {%- assign row_url = '' -%}
          {%- assign row_price = '' -%}
          {%- assign row_variant = blank -%}
          {%- for lp in block_list -%}
            {%- if lp.selected_or_first_available_variant.sku == c[0] -%}
              {%- assign row_url = lp.url -%}
              {%- assign row_price = lp.selected_or_first_available_variant.price | money -%}
              {%- assign row_variant = lp.selected_or_first_available_variant -%}
            {%- endif -%}
          {%- endfor -%}
          <tr{% if c[0] == current_sku %} class="is-current" aria-current="true"{% endif %}>
            <td class="bk-specs__sku">{% if row_url != blank %}<a href="{{ row_url }}">{{ c[0] }}</a>{% else %}{{ c[0] }}{% endif %}{% if c[0] == current_sku %}<span class="bk-specs__tag">This item</span>{% endif %}</td>
            <td>{{ c[1] }}</td>
            <td>{{ c[2] }}</td>
            <td>{{ c[3] }}</td>
            <td>{{ c[4] }}</td>
            <td><strong>{{ c[5] }} ton</strong><br><span class="bk-specs__sub">{{ c[6] }} lbs</span></td>
            <td>{{ c[7] }} lb</td>
            <td class="bk-specs__price">{% if row_url != blank %}<a href="{{ row_url }}">{{ row_price }}</a>{% else %}&mdash;{% endif %}</td>
            <td class="bk-specs__buycell">{%- if row_variant != blank -%}{%- if row_variant.available -%}<form method="post" action="{{ routes.cart_add_url }}" class="bk-specs__buy"><input type="hidden" name="id" value="{{ row_variant.id }}"><input type="hidden" name="quantity" value="1"><input type="hidden" name="return_to" value="/checkout"><button type="submit" class="bk-specs__btn" aria-label="Buy now: {{ c[0] }}">Buy now</button></form>{%- else -%}<span class="bk-specs__btn is-off">Sold out</span>{%- endif -%}{%- else -%}&mdash;{%- endif -%}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
  <p class="bk-specs__foot">Capacity is per stack configuration; build crossing layers on level, prepared ground and follow the product manual. Dimensions are nominal overall size, including ribs.</p>
</div>
<style>
  *:has(> .bk-specs) { min-width: 0; max-width: 100%; }
  .bk-specs { --bk-top: #ffffff; --bk-side: #e9e9e9; --bk-end: #f4f4f4; --bk-hole: #555555; --bk-chan: #cfcfcf; width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box; display: flex; flex-direction: column; gap: 16px; padding-top: 8px; border-top: 1px solid rgba(0,0,0,0.15); }
  .bk-specs__title { margin: 12px 0 0; }
  .bk-specs__figure { margin: 0; }
  .bk-specs__cap { font-size: 0.85em; opacity: 0.7; margin-top: 4px; }
  .bk-specs__svg { display: block; width: 100%; height: auto; max-width: 680px; color: #000; }
  .bk-specs__dim { font: 700 18px/1 var(--font-heading--family, sans-serif); letter-spacing: 0.04em; fill: currentColor; }
  .bk-specs__note { font: 500 13px/1 var(--font-body--family, sans-serif); fill: currentColor; opacity: 0.7; }
  .bk-specs__tablewrap { width: 100%; max-width: 100%; min-width: 0; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .bk-specs__table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 0.92em; }
  .bk-specs__table th { text-align: left; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.8em; background: #000; color: #fff; padding: 10px; white-space: nowrap; }
  .bk-specs__table td { padding: 10px; border-bottom: 1px solid #dfdfdf; vertical-align: middle; white-space: nowrap; }
  .bk-specs__table tr.is-current td { background: #f2f2f2; font-weight: 700; }
  .bk-specs__sku, .bk-specs__price { font-variant-numeric: tabular-nums; }
  .bk-specs__table a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .bk-specs__price a { font-weight: 700; }
  .bk-specs__buycell { text-align: right; }
  .bk-specs__buy { margin: 0; display: inline; }
  .bk-specs__btn { display: inline-block; background: #000; color: #fff; border: 1px solid #000; border-radius: 0; padding: 9px 16px; font: inherit; font-size: 0.78em; font-weight: 700; line-height: 1; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; white-space: nowrap; text-decoration: none; }
  .bk-specs__btn:hover, .bk-specs__btn:focus-visible { background: #fff; color: #000; }
  .bk-specs__btn:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
  .bk-specs__btn.is-off { background: transparent; color: #767676; border-color: #c4c4c4; cursor: default; }
  .bk-specs__table tr.is-current .bk-specs__btn.is-off { background: transparent; }
  .bk-specs__tag { display: inline-block; margin-left: 8px; padding: 2px 6px; font-size: 0.72em; letter-spacing: 0.05em; text-transform: uppercase; background: #000; color: #fff; }
  .bk-specs__sub { font-size: 0.85em; opacity: 0.7; font-weight: 400; }
  .bk-specs__foot { margin: 0; font-size: 0.85em; opacity: 0.75; }
</style>
{%- endif -%}
