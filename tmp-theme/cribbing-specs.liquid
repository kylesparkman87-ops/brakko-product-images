{%- liquid
  assign p = closest.product
  if p == blank
    assign p = product
  endif
  assign current_sku = p.selected_or_first_available_variant.sku
  assign rows = '32-020418|2 x 4 x 18|18|4|2|10|20,000|5.2;32-040418|4 x 4 x 18|18|4|4|20|40,000|8.9;32-060724|6 x 7 x 24|24|6|7|100|200,000|26.5;32-121206|12 x 12 x 6|12|12|6|100|200,000|29.8;32-122406|12 x 24 x 6|24|12|6|100|200,000|59.6' | split: ';'
  assign block_list = collections['cribbing-blocks'].products
  assign show_block = false
  if p != blank and p.type == 'Cribbing Block'
    assign show_block = true
  endif
  if collection.handle == 'cribbing-blocks'
    assign show_block = true
  endif
  assign show_drawing = ''
  if collection.handle == 'cribbing-blocks'
    assign show_drawing = '32-060724'
  endif
  case current_sku
    when '32-060724', '32-040418', '32-121206', '32-122406'
      assign show_drawing = current_sku
  endcase
-%}
