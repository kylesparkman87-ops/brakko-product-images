{%- liquid
  assign p = closest.product
  if p == blank
    assign p = product
  endif
  assign show = false
  if p != blank and p.type == 'Cribbing Block'
    assign show = true
  endif
  if collection.handle == 'cribbing-blocks' or collection.handle == 'cribbing-kits'
    assign show = true
  endif
-%}
{%- if show -%}
<div class="bk-cx" id="bk-cx-{{ block.id }}" {{ block.shopify_attributes }}>
  <h3 class="bk-cx__title">{{ block.settings.heading | escape }}</h3>
  <p class="bk-cx__lede">The same 50,000 lb load on soft ground, held by a jack stand and by a Brakko crib kit. Ground pressure is the load divided by the area touching the ground.</p>
<style>
  .bk-cx {
    --bg: #f1f2f1;
    --panel: #ffffff;
    --ink: #121314;
    --muted: #5d6268;
    --line: #d5d8da;
    --soil: #9a7a58;
    --soil-deep: #7d6145;
    --grain: #5f4732;
    --steel: #6c737b;
    --rail: #2b2f33;
    --jack: #c4342b;
    --plate: #18191b;
    --plate-edge: #000000;
    --hot: #e2551b;
    --sleeve: #2563c9;
    --rope: #f4f1e8;
    --hi: #f2b705;
    --stand: #c4342b;
    --block: #2a2c2f;
    --block-hi: #3a3d41;
    --slot: #0b0c0d;
    --grip: #2fae3a;
    --font-display: var(--font-heading--family, "Oswald"), "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
    --font-body: var(--font-body--family, "Barlow"), "Helvetica Neue", Arial, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  }
  *:has(> .bk-cx) { min-width: 0; max-width: 100%; }
  .bk-cx { width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box; display: flex; flex-direction: column; gap: 16px; padding-top: 8px; border-top: 1px solid rgba(0,0,0,0.15); color: var(--ink); font-family: var(--font-body); }
  .bk-cx * { box-sizing: border-box; }
  .bk-cx__title { margin: 12px 0 0; }
  .bk-cx__lede { margin: 0; color: var(--muted); max-width: 64ch; }
  .bk-cx .bk-cx__sub { margin: 4px 0 0; }
  @media (max-width: 560px) { .bk-cx .scenes { margin-left: 0; } }
.bk-cx .stage { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .bk-cx .stage svg { display: block; width: 100%; height: auto; max-width: 100%; }
  .bk-cx .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; padding: 12px 14px; border-top: 1px solid var(--line); }
  .bk-cx .controls { display: flex; gap: 8px; }
  .bk-cx .scenes { display: flex; flex-wrap: wrap; gap: 6px; margin-left: auto; }
  .bk-cx button { font: 600 0.82rem/1 var(--font-body); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); background: transparent; border: 1px solid var(--ink); border-radius: 0; padding: 10px 14px; cursor: pointer; }
  .bk-cx button:hover { background: var(--ink); color: var(--panel); }
  .bk-cx button[aria-pressed="true"] { background: var(--ink); color: var(--panel); }
  .bk-cx button:focus-visible { outline: 3px solid var(--hi); outline-offset: 2px; }
  .bk-cx .progress { flex: 1 1 100%; height: 3px; background: var(--line); position: relative; order: 3; }
  .bk-cx .progress span { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--hot); }
  .bk-cx .caption { min-height: 4.6em; margin: 0; padding: 16px 18px; border-left: 4px solid var(--hot); background: var(--panel); font-size: 1.06rem; max-width: 100%; }
  .bk-cx .caption strong { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; display: block; font-size: 0.95rem; margin-bottom: 2px; }
  .bk-cx h2 { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; font-size: 1.35rem; margin: 12px 0 0; }
  .bk-cx .tablewrap { overflow-x: auto; border: 1px solid var(--line); background: var(--panel); }
  .bk-cx table { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 0.95rem; }
  .bk-cx th { text-align: left; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.75rem; background: var(--ink); color: var(--panel); padding: 10px 12px; white-space: nowrap; }
  .bk-cx td { padding: 10px 12px; border-top: 1px solid var(--line); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .bk-cx td.num { font-family: var(--font-mono); text-align: right; }
  .bk-cx th.num { text-align: right; }
  .bk-cx tr.ref td { color: var(--muted); }
  .bk-cx tr.grp th { background: var(--bg); color: var(--ink); text-align: left; font-size: 0.75rem; letter-spacing: 0.06em; padding: 10px 12px; border-top: 2px solid var(--ink); white-space: normal; }
  .bk-cx .notes { margin: 0; padding-left: 1.2em; color: var(--muted); font-size: 0.9rem; display: grid; gap: 6px; max-width: 80ch; }

  /* SVG classes */
  .bk-cx .t-display { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; fill: var(--ink); }
  .bk-cx .t-body { font-family: var(--font-body); fill: var(--ink); }
  .bk-cx .t-muted { font-family: var(--font-body); fill: var(--muted); }
  .bk-cx .t-mono { font-family: var(--font-mono); fill: var(--muted); }
  .bk-cx .t-hot { fill: var(--hot); }
  .bk-cx .f-soil { fill: var(--soil); }
  .bk-cx .f-grain { fill: var(--grain); }
  .bk-cx .s-strata { stroke: var(--soil-deep); stroke-width: 2; fill: none; opacity: 0.6; }
  .bk-cx .f-hot { fill: var(--hot); }
  .bk-cx .s-hot { stroke: var(--hot); }
  .bk-cx .f-jack { fill: var(--jack); }
  .bk-cx .f-steel { fill: var(--steel); }
  .bk-cx .f-rail { fill: var(--rail); }
  .bk-cx .f-plate { fill: var(--plate); stroke: var(--plate-edge); stroke-width: 2; }
  .bk-cx .s-ink { stroke: var(--ink); fill: none; }
  .bk-cx .f-ink { fill: var(--ink); }
  .bk-cx .s-line { stroke: var(--line); }
  .bk-cx .s-muted { stroke: var(--muted); }
  .bk-cx .f-sleeve { fill: none; stroke: var(--sleeve); stroke-width: 9; stroke-linecap: round; }
  .bk-cx .s-rope { fill: none; stroke: var(--rope); stroke-width: 5; stroke-linecap: round; }
  .bk-cx .s-rope-edge { fill: none; stroke: var(--muted); stroke-width: 7; stroke-linecap: round; }
  .bk-cx .f-panel { fill: var(--panel); }
  .bk-cx .f-stand { fill: var(--stand); }
  .bk-cx .s-stand { stroke: var(--stand); fill: none; }
  .bk-cx .f-block { fill: var(--block); }
  .bk-cx .f-block-hi { fill: var(--block-hi); }
  .bk-cx .s-blockedge { fill: none; stroke: var(--plate-edge); stroke-width: 1.5; }
  .bk-cx .f-slot { fill: var(--slot); }
  .bk-cx .f-grip { fill: none; stroke: var(--grip); stroke-width: 6; stroke-linecap: round; }
  .bk-cx .t-onbar { fill: var(--panel); }
  </style>
<script>

(function () {
  var SUF = '-{{ block.id }}';
  var ROOT = document.getElementById('bk-cx' + SUF);
  if (!ROOT || ROOT.dataset.init) return; ROOT.dataset.init = '1';
  var NS = 'http://www.w3.org/2000/svg';
  var G = 500, CX = 600, LOAD = 50000, PX = 14;
  var STAND_PSI = LOAD / 16, CRIB_PSI = LOAD / 576;
  var SCENES = [0, 9500, 19000, 30000];
  var CAPTIONS = [
    ['Jack stand on soft ground', 'A 50,000 lb load on four small stand feet puts about 3,125 psi on the ground. The feet punch in unevenly, the stand leans, and a tall, narrow, light support has little to stop it going over.'],
    ['Brakko crib kit', 'The same load on a 24 × 24 Anchor base plate is about 87 psi, 36 times less. The crib is low, wide and heavy, about 320 lb before any load, and crossing layers with a locking top plate keep it from shifting.'],
    ['Size the support to the ground', 'The crib cuts ground pressure 36 times, but at 50,000 lb even 87 psi is well above what soft soil can carry. Build on firm, prepared ground or add ground mats under the base. The Anchor base plate gives the bottom layer one flat, continuous bearing surface so it settles evenly.']
  ];

  function el(tag, attrs, parent) {
    var e = document.createElementNS(NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    if (parent) parent.appendChild(e);
    return e;
  }
  function $(id) { return document.getElementById(id + SUF); }
  function clamp(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
  function ease(x) { x = clamp(x); return x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2; }
  function setLine(g, x1, y1, x2, y2) {
    var l = g.querySelector('line'), c = g.querySelector('circle');
    l.setAttribute('x1', x1); l.setAttribute('y1', y1); l.setAttribute('x2', x2); l.setAttribute('y2', y2);
    c.setAttribute('cx', x1); c.setAttribute('cy', y1);
  }

  // soil texture
  var seed = 11;
  function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }
  [560, 605].forEach(function (y, i) {
    el('path', { d: 'M0 ' + y + ' C 300 ' + (y - 8 + i * 6) + ', 700 ' + (y + 10) + ', 1200 ' + (y - 4), 'class': 's-strata' }, $('strata'));
  });
  for (var i = 0; i < 260; i++) {
    el('circle', { cx: (rnd() * 1200).toFixed(1), cy: (G - 30 + rnd() * 170).toFixed(1), r: (1.2 + rnd() * 2.4).toFixed(1), 'class': 'f-grain', opacity: (0.35 + rnd() * 0.5).toFixed(2) }, $('grains'));
  }

  // ---- jack stand (side view): 10 in base, 22.6 in tall to match the crib
  var standH = 22.6 * PX, SPREAD = 5 * PX, FOOT = 2 * PX;
  var stand = $('stand');
  var top = G - standH;
  [-1, 1].forEach(function (d) {
    el('path', { d: 'M' + (CX + d * (SPREAD - 4)) + ' ' + (G - 6) + ' L' + (CX + d * 20) + ' ' + (G - 150) + ' L' + (CX + d * 26) + ' ' + (G - 150) + ' L' + (CX + d * (SPREAD + 4)) + ' ' + (G - 6) + ' Z', 'class': 'f-stand' }, stand);
    el('rect', { x: CX + d * SPREAD - FOOT / 2, y: G - 6, width: FOOT, height: 6, 'class': 'f-stand' }, stand);
  });
  el('rect', { x: CX - 30, y: G - 168, width: 60, height: 22, rx: 3, 'class': 'f-stand' }, stand);
  el('rect', { x: CX - 13, y: top + 12, width: 26, height: G - 168 - top - 12, 'class': 'f-steel' }, stand);
  for (var t = 0; t < 7; t++) el('rect', { x: CX - 13, y: top + 30 + t * 18, width: 8, height: 6, 'class': 'f-rail' }, stand);
  el('path', { d: 'M' + (CX - 34) + ' ' + (top) + ' L' + (CX + 34) + ' ' + top + ' L' + (CX + 24) + ' ' + (top + 12) + ' L' + (CX - 24) + ' ' + (top + 12) + ' Z', 'class': 'f-stand' }, stand);
  el('path', { d: 'M' + (CX + 30) + ' ' + (G - 160) + ' l 40 -26', 'class': 's-stand', 'stroke-width': 8, 'stroke-linecap': 'round' }, stand);

  // ---- crib kit (side view), 14 px per inch
  var crib = $('crib');
  var W24 = 24 * PX, PL = 2 * PX, LY = 6.2 * PX, BW = 7 * PX;
  var x0 = CX - W24 / 2, y = G;
  function plate(yb, label) {
    el('rect', { x: x0 - 4, y: yb - PL, width: W24 + 8, height: PL, rx: 3, 'class': 'f-plate' }, crib);
    return yb - PL;
  }
  function endOnLayer(yb) {
    var gap = (W24 - 3 * BW) / 2;
    for (var k = 0; k < 3; k++) {
      var bx = x0 + k * (BW + gap);
      el('rect', { x: bx, y: yb - LY, width: BW, height: LY, rx: 2, 'class': 'f-block' }, crib);
      el('rect', { x: bx, y: yb - LY, width: BW, height: 5, 'fill': 'url(#pyr' + SUF + ')' }, crib);
      el('rect', { x: bx, y: yb - 5, width: BW, height: 5, 'fill': 'url(#pyr' + SUF + ')' }, crib);
      el('rect', { x: bx + 10, y: yb - LY + 12, width: 40, height: 20, rx: 1, 'class': 'f-slot' }, crib);
      el('rect', { x: bx + 22, y: yb - LY / 2 + 2, width: 54, height: 18, rx: 9, 'class': 'f-slot' }, crib);
      el('path', { d: 'M' + (bx + 20) + ' ' + (yb - 22) + ' q 30 26 60 0', 'class': 'f-grip' }, crib);
    }
    return yb - LY;
  }
  function longLayer(yb) {
    el('rect', { x: x0, y: yb - LY, width: W24, height: LY, rx: 2, 'fill': 'url(#pyr' + SUF + ')' }, crib);
    [[0, 1.42], [7.62, 8.73], [14.93, 16.04], [22.58, 24]].forEach(function (r) {
      el('rect', { x: x0 + r[0] * PX, y: yb - LY, width: (r[1] - r[0]) * PX, height: LY, 'class': 'f-block' }, crib);
    });
    el('rect', { x: x0, y: yb - LY, width: W24, height: LY, rx: 2, 'class': 's-blockedge' }, crib);
    return yb - LY;
  }
  y = plate(y);
  var basePlateTop = y;
  y = endOnLayer(y); y = longLayer(y); y = endOnLayer(y);
  var topPlateY = y;
  y = plate(y);
  var cribTop = y;

  // ---- pressure bulbs and arrows
  var bulb = $('bulb'), contours = [];
  for (var k = 5; k >= 1; k--) contours.push({ k: k, a: el('path', { 'class': 'f-hot' }, bulb), b: el('path', { 'class': 'f-hot' }, bulb) });
  var arrowNodes = [];
  for (var a = 0; a < 11; a++) arrowNodes.push(el('line', { 'class': 's-hot', 'stroke-width': 5, 'marker-end': 'url(#ah' + SUF + ')' }, $('pArrows')));

  function halfEllipse(cx, topY, rx, ry) { return 'M' + (cx - rx) + ' ' + topY + ' A' + rx + ' ' + ry + ' 0 0 0 ' + (cx + rx) + ' ' + topY + ' Z'; }

  function soilPath(sL, sR) {
    var fl = CX - SPREAD, fr = CX + SPREAD, dl = sL * 34, dr = sR * 14, h = Math.max(sL, sR) * 10;
    return 'M0 ' + G + ' H' + (fl - 40) + ' Q' + (fl - 28) + ' ' + (G - h) + ' ' + (fl - 18) + ' ' + G +
      ' L' + (fl - 15) + ' ' + (G + dl) + ' L' + (fl + 15) + ' ' + (G + dl) + ' L' + (fl + 18) + ' ' + G +
      ' H' + (fr - 18) + ' L' + (fr - 15) + ' ' + (G + dr) + ' L' + (fr + 15) + ' ' + (G + dr) + ' L' + (fr + 18) + ' ' + G +
      ' Q' + (fr + 28) + ' ' + (G - h * 0.5) + ' ' + (fr + 40) + ' ' + G + ' H1200 V640 H0 Z';
  }

  function renderAB(mode, u) {
    var pa = ease(u / 1200), p = ease((u - 1200) / 2600);
    var s = mode === 0 ? ease((u - 4300) / 2400) : 0;
    var cribA = mode === 1 ? ease(u / 700) : 0;
    var sp = mode === 0 ? soilPath(s, s) : soilPath(0, 0);
    $('soil').setAttribute('d', sp); $('soilClipPath').setAttribute('d', sp);

    var tilt = -6 * s, drop = 24 * s;
    $('stand').setAttribute('opacity', mode === 0 ? 1 : 0);
    $('stand').setAttribute('transform', 'translate(0 ' + drop.toFixed(2) + ') rotate(' + tilt.toFixed(2) + ' ' + (CX + SPREAD) + ' ' + G + ')');
    $('crib').setAttribute('opacity', cribA.toFixed(2));

    var supTop = mode === 0 ? top : cribTop;
    var railY = supTop - 40 + (mode === 0 ? drop + 8 * s : 0);
    $('rail').setAttribute('transform', 'translate(0 ' + railY.toFixed(1) + ')' + (mode === 0 ? ' rotate(' + (-2 * s).toFixed(2) + ' 600 40)' : ''));
    var la = $('loadArrow'), al = la.querySelector('line'), at = la.querySelector('text');
    var ay = railY - 8;
    al.setAttribute('y1', ay - 100); al.setAttribute('y2', ay - 10);
    at.setAttribute('y', ay - 60);
    la.setAttribute('transform', 'translate(0 ' + ((1 - pa) * -50).toFixed(1) + ')');
    la.setAttribute('opacity', pa.toFixed(2));

    $('callA').setAttribute('opacity', mode === 0 ? 1 : 0);
    $('callB').setAttribute('opacity', mode === 1 ? cribA.toFixed(2) : 0);
    $('callLock').setAttribute('opacity', mode === 1 ? clamp((u - 4600) / 700).toFixed(2) : 0);
    setLine($('callA'), CX - SPREAD - 16, G - 3, 330, 340);
    setLine($('callB'), x0 - 6, G - 14, 330, 340);
    setLine($('callLock'), x0 + 30, cribTop + 14, 330, 196);

    // bulbs
    contours.forEach(function (c) {
      if (mode === 0) {
        var rx = FOOT / 2 * (0.9 + 0.55 * c.k) * (0.4 + 0.6 * p), ry = FOOT * 0.55 * c.k * p + 0.01;
        var op = (p * (0.22 + 0.12 * (6 - c.k))).toFixed(3);
        c.a.setAttribute('d', halfEllipse(CX - SPREAD, G + s * 34, rx, ry)); c.a.setAttribute('opacity', op);
        c.b.setAttribute('d', halfEllipse(CX + SPREAD, G + s * 14, rx, ry)); c.b.setAttribute('opacity', op);
      } else {
        var rx2 = W24 / 2 * (0.75 + 0.3 * c.k) * (0.4 + 0.6 * p), ry2 = W24 * 0.12 * c.k * p + 0.01;
        c.a.setAttribute('d', halfEllipse(CX, G, rx2, ry2)); c.a.setAttribute('opacity', (p * 0.22 * (0.22 + 0.12 * (6 - c.k))).toFixed(3));
        c.b.setAttribute('d', '');
      }
    });
    arrowNodes.forEach(function (n, i) {
      var x, len, y0;
      if (mode === 0) {
        if (i > 3 || p <= 0) { n.setAttribute('opacity', 0); return; }
        var foot = i < 2 ? CX - SPREAD : CX + SPREAD;
        x = foot + (i % 2 ? 6 : -6); y0 = G + (i < 2 ? s * 34 : s * 14) + 6; len = 78;
      } else {
        if (p <= 0) { n.setAttribute('opacity', 0); return; }
        x = x0 + 10 + (W24 - 20) * i / 10; y0 = G + 6; len = 14;
      }
      n.setAttribute('x1', x); n.setAttribute('x2', x); n.setAttribute('y1', y0); n.setAttribute('y2', y0 + len * p);
      n.setAttribute('opacity', p.toFixed(2));
    });

    $('sceneLabel').textContent = mode === 0 ? 'Jack stand' : 'Brakko crib kit';
    var psiVal = mode === 0 ? STAND_PSI : CRIB_PSI;
    $('psi').textContent = Math.round(psiVal * p).toLocaleString('en-US') + ' psi';
    $('formula').textContent = mode === 0 ? '50,000 lb ÷ 16 sq in' : '50,000 lb ÷ 576 sq in';
    $('warn').setAttribute('opacity', mode === 0 ? clamp((s - 0.5) * 3).toFixed(2) : 0);
    var okA = mode === 1 ? clamp((u - 4200) / 700) : 0;
    $('ok').setAttribute('opacity', okA.toFixed(2));
    $('ok2').setAttribute('opacity', okA.toFixed(2));
  }

  // ---- chart, log scale 5..1000 psi
  var chart = $('chart');
  var X0 = 420, XW = 700, LMIN = Math.log(5), LMAX = Math.log(5000);
  function xs(v) { return X0 + XW * (Math.log(v) - LMIN) / (LMAX - LMIN); }
  function fitBg(bg, t) { try { var b = t.getBBox(); bg.setAttribute('x', b.x - 4); bg.setAttribute('y', b.y - 2); bg.setAttribute('width', b.width + 8); bg.setAttribute('height', b.height + 4); } catch (e) {} }
  [5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000].forEach(function (t) {
    el('line', { x1: xs(t), x2: xs(t), y1: 200, y2: 540, 'class': 's-line', 'stroke-width': 1 }, chart);
    var tx = el('text', { x: xs(t), y: 572, 'text-anchor': 'middle', 'class': 't-mono', 'font-size': 18 }, chart); tx.textContent = t;
  });
  var ax = el('text', { x: X0 + XW, y: 602, 'text-anchor': 'end', 'class': 't-muted', 'font-size': 18 }, chart); ax.textContent = 'psi';
  var refs = [[10.4, 'Clay 10.4', 270], [13.9, 'Sand 13.9', 236], [20.8, 'Gravel 20.8', 202]];
  refs.forEach(function (r) { el('line', { x1: xs(r[0]), x2: xs(r[0]), y1: r[2] - 22, y2: 540, 'class': 's-muted', 'stroke-width': 2, 'stroke-dasharray': '6 6' }, chart); });
  refs.forEach(function (r) {
    var bg = el('rect', { 'class': 'f-panel' }, chart);
    var t = el('text', { x: xs(r[0]) + 8, y: r[2] - 4, 'class': 't-muted', 'font-size': 19 }, chart); t.textContent = r[1];
    fitBg(bg, t);
  });
  var rows = [
    { label: 'Jack stand', sub: '16 sq in of feet', v: STAND_PSI, hot: true },
    { label: 'Crib on bare soil', sub: '504 sq in, bottom layer', v: LOAD / 504 },
    { label: 'Crib kit + Anchor base', sub: '576 sq in plate', v: CRIB_PSI }
  ];
  rows.forEach(function (r, i) {
    var yy = 320 + i * 80;
    var l = el('text', { x: 40, y: yy + 6, 'class': 't-display', 'font-size': 26 }, chart); l.textContent = r.label;
    var sb = el('text', { x: 40, y: yy + 32, 'class': 't-muted', 'font-size': 19 }, chart); sb.textContent = r.sub;
    r.bar = el('rect', { x: X0, y: yy - 18, height: 36, width: 0, 'class': r.hot ? 'f-hot' : 'f-ink' }, chart);
    r.bg = el('rect', { 'class': 'f-panel' }, chart);
    r.val = el('text', { y: yy + 9, 'class': 't-display', 'font-size': 24 }, chart);
  });
  function renderC(u) {
    rows.forEach(function (r, i) {
      var g = ease((u - 500 - i * 1000) / 1000);
      var w = (xs(r.v) - X0) * g;
      r.bar.setAttribute('width', Math.max(0, w).toFixed(1));
      var tx = X0 + w + 10, anchor = 'start';
      if (r.v > 1000) { tx = X0 + w - 12; anchor = 'end'; }
      r.val.setAttribute('x', tx.toFixed(1)); r.val.setAttribute('text-anchor', anchor);
      r.val.setAttribute('class', 't-display' + (r.v > 1000 ? ' t-onbar' : ''));
      r.val.textContent = g > 0 ? (r.v * g).toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' psi' : '';
      if (g > 0 && r.v <= 1000) fitBg(r.bg, r.val); else r.bg.setAttribute('width', 0);
    });
  }

  // ---- timeline
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var tt = 0, playing = !reduce, last = null, curScene = -1;
  var playBtn = $('playBtn'), prog = $('prog'), cap = $('caption');
  var sceneBtns = Array.prototype.slice.call(ROOT.querySelectorAll('[data-scene]'));
  function sceneOf(time) { return time < SCENES[1] ? 0 : time < SCENES[2] ? 1 : 2; }
  function render(time) {
    var sc = sceneOf(time), u = time - SCENES[sc];
    $('sceneAB').setAttribute('opacity', sc < 2 ? 1 : 0);
    $('sceneC').setAttribute('opacity', sc === 2 ? 1 : 0);
    if (sc < 2) renderAB(sc, u); else renderC(u);
    if (sc !== curScene) {
      curScene = sc;
      cap.innerHTML = '<strong>' + CAPTIONS[sc][0] + '</strong>' + CAPTIONS[sc][1];
      sceneBtns.forEach(function (b) { b.setAttribute('aria-pressed', String(+b.dataset.scene === sc)); });
    }
    prog.style.width = (100 * time / SCENES[3]).toFixed(2) + '%';
  }
  function frame(ts) {
    if (playing) { if (last !== null) tt += Math.min(ts - last, 100); if (tt >= SCENES[3]) tt = 0; render(tt); }
    last = ts; requestAnimationFrame(frame);
  }
  function setPlaying(v) { playing = v; playBtn.textContent = v ? 'Pause' : 'Play'; playBtn.setAttribute('aria-label', v ? 'Pause' : 'Play'); }
  playBtn.addEventListener('click', function () { setPlaying(!playing); });
  $('replayBtn').addEventListener('click', function () { tt = 0; render(tt); if (!reduce) setPlaying(true); });
  sceneBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      var sc = +b.dataset.scene;
      if (reduce) { tt = SCENES[sc + 1] - 1; render(tt); return; }
      tt = SCENES[sc]; render(tt); setPlaying(true);
    });
  });
  tt = reduce ? SCENES[1] - 1 : 0;
  render(reduce ? tt : 8000);
  setPlaying(!reduce);
  if (!reduce) render(0);
  requestAnimationFrame(frame);
})();
</script>
