{%- liquid
  assign p = closest.product
  if p == blank
    assign p = product
  endif
  assign show = false
  if p != blank and p.type == 'Jack Plate'
    assign show = true
  endif
  if collection.handle == 'jack-plates'
    assign show = true
  endif
-%}
{%- if show -%}
<div class="bk-ls" id="bk-ls-{{ block.id }}" {{ block.shopify_attributes }}>
  <h3 class="bk-ls__title">{{ block.settings.heading | escape }}</h3>
  <p class="bk-ls__lede">The same 5,000 lb load on soft ground, with and without a Bedrock jack plate. Ground pressure is the load divided by the area touching the ground.</p>
<section class="stage" aria-label="Animated load spread explainer">
    <svg id="svg-{{ block.id }}" viewBox="0 0 1200 640" role="img" aria-labelledby="svgDesc-{{ block.id }}">
      <desc id="svgDesc-{{ block.id }}">Side view of a bottle jack lifting a truck frame rail. Without a plate the narrow jack base concentrates pressure and sinks into the soil. With a 12 by 12 inch plate the pressure spreads wide and the jack stays level. A chart compares ground pressure for each plate size.</desc>
      <defs>
        <marker id="ah-{{ block.id }}" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="3" markerHeight="3" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="f-hot"/></marker>
                <clipPath id="soilClip-{{ block.id }}"><path id="soilClipPath-{{ block.id }}" d=""/></clipPath>
      </defs>

      <g id="sceneAB-{{ block.id }}">
        <path id="soil-{{ block.id }}" class="f-soil" d=""/>
        <g clip-path="url(#soilClip-{{ block.id }})">
          <g id="strata-{{ block.id }}"></g>
          <g id="grains-{{ block.id }}"></g>
          <g id="bulb-{{ block.id }}"></g>
          <g id="pArrows-{{ block.id }}"></g>
        </g>
        <g id="plateG-{{ block.id }}" opacity="0">
          <path class="s-rope-edge" d="M718 418 Q 742 418 752 434 M 806 434 Q 790 424 718 428"/>
          <path class="s-rope" d="M718 418 Q 742 418 752 434 M 806 434 Q 790 424 718 428"/>
          <path class="f-sleeve" d="M752 435 L 806 435"/>
          <rect class="f-plate" x="480" y="410" width="240" height="30" rx="4"/>
          <g id="plateCallout-{{ block.id }}">
            <line x1="470" y1="425" x2="350" y2="352" class="s-ink" stroke-width="2"/>
            <circle cx="476" cy="426" r="5" class="f-ink"/>
            <text x="110" y="310" class="t-display" font-size="30">144 sq in contact</text>
            <text x="110" y="340" class="t-muted" font-size="22">12 × 12 in Bedrock plate</text>
          </g>
        </g>
        <g id="rail-{{ block.id }}">
          <rect class="f-rail" x="400" y="158" width="400" height="40" rx="3"/>
          <text x="410" y="150" class="t-muted" font-size="20">Truck frame rail</text>
        </g>
        <g id="loadArrow-{{ block.id }}">
          <line x1="600" y1="40" x2="600" y2="140" class="s-hot" stroke-width="10" marker-end="url(#ah-{{ block.id }})"/>
          <text x="625" y="80" class="t-display t-hot" font-size="30">5,000 lb</text>
        </g>
        <g id="jack-{{ block.id }}">
          <rect class="f-steel" x="574" y="198" width="52" height="10" rx="2"/>
          <rect class="f-steel" x="584" y="208" width="32" height="60"/>
          <rect class="f-jack" x="552" y="268" width="96" height="150" rx="8"/>
          <rect class="f-rail" x="648" y="372" width="36" height="40" rx="4"/>
          <rect class="f-jack" x="530" y="418" width="140" height="22" rx="3"/>
        </g>
        <g id="baseCallout-{{ block.id }}">
          <line x1="524" y1="432" x2="350" y2="352" class="s-ink" stroke-width="2"/>
          <circle cx="528" cy="432" r="5" class="f-ink"/>
          <text x="110" y="310" class="t-display" font-size="30">42 sq in contact</text>
          <text x="110" y="340" class="t-muted" font-size="22">6 × 7 in jack base</text>
        </g>
        <text id="sceneLabel-{{ block.id }}" x="40" y="62" class="t-display" font-size="34"></text>
        <g id="readout-{{ block.id }}">
          <text x="1160" y="140" text-anchor="end" class="t-muted" font-size="20" letter-spacing="2">GROUND PRESSURE</text>
          <text id="psi-{{ block.id }}" x="1160" y="212" text-anchor="end" class="t-display" font-size="78">0 psi</text>
          <text id="formula-{{ block.id }}" x="1160" y="246" text-anchor="end" class="t-mono" font-size="22"></text>
          <text id="warn-{{ block.id }}" x="1160" y="300" text-anchor="end" class="t-display t-hot" font-size="30" opacity="0">Base sinks, jack tips</text>
          <text id="ok-{{ block.id }}" x="1160" y="300" text-anchor="end" class="t-display" font-size="30" opacity="0">3.4× less pressure</text>
        </g>
      </g>

      <g id="sceneC-{{ block.id }}" opacity="0">
        <text x="40" y="62" class="t-display" font-size="34">Ground pressure, 5,000 lb load</text>
        <text x="40" y="94" class="t-muted" font-size="20">Log scale. Dashed lines: building-code presumptive bearing values for soil.</text>
        <g id="chart-{{ block.id }}"></g>
      </g>
    </svg>
    <div class="bar">
      <div class="controls">
        <button id="playBtn-{{ block.id }}" type="button" aria-label="Pause">Pause</button>
        <button id="replayBtn-{{ block.id }}" type="button">Replay</button>
      </div>
      <div class="scenes" role="group" aria-label="Jump to scene">
        <button type="button" data-scene="0" aria-pressed="true">No plate</button>
        <button type="button" data-scene="1" aria-pressed="false">With plate</button>
        <button type="button" data-scene="2" aria-pressed="false">Compare sizes</button>
      </div>
      <div class="progress" aria-hidden="true"><span id="prog-{{ block.id }}"></span></div>
    </div>
  </section>

  <p class="caption" id="caption-{{ block.id }}" aria-live="polite"></p>

  <h4 class="bk-ls__sub">The numbers</h4>
  <div class="tablewrap">
    <table>
      <thead><tr><th>Ground contact</th><th class="num">Contact area</th><th class="num">Ground pressure</th><th class="num">Vs. jack base alone</th></tr></thead>
      <tbody>
        <tr><td>Jack base only (6 × 7 in)</td><td class="num">42 sq in</td><td class="num">119.0 psi</td><td class="num">1.0×</td></tr>
        <tr><td>12 × 12 in Bedrock plate</td><td class="num">144 sq in</td><td class="num">34.7 psi</td><td class="num">3.4× less</td></tr>
        <tr><td>18 × 18 in Bedrock plate</td><td class="num">324 sq in</td><td class="num">15.4 psi</td><td class="num">7.7× less</td></tr>
        <tr><td>24 × 24 in Bedrock plate</td><td class="num">576 sq in</td><td class="num">8.7 psi</td><td class="num">13.7× less</td></tr>
        <tr class="grp"><th colspan="4" scope="rowgroup">What the ground can carry (building code values)</th></tr>
        <tr class="ref"><td>Sandy gravel and gravel</td><td class="num">3,000 psf</td><td class="num">20.8 psi</td><td class="num">Soil can carry</td></tr>
        <tr class="ref"><td>Sand, silty sand</td><td class="num">2,000 psf</td><td class="num">13.9 psi</td><td class="num">Soil can carry</td></tr>
        <tr class="ref"><td>Clay, silt</td><td class="num">1,500 psf</td><td class="num">10.4 psi</td><td class="num">Soil can carry</td></tr>
      </tbody>
    </table>
  </div>
  <ul class="notes">
    <li>Example load of 5,000 lb, about one front corner of a medium-duty truck. Pressure = load ÷ contact area, assuming a rigid plate with the jack centered on it.</li>
    <li>The 6 × 7 in base is typical of a 20-ton bottle jack. Measure your own jack's base.</li>
    <li>Soil values are presumptive load-bearing values from IBC Table 1806.2. They are conservative numbers for permanent foundations, shown here for comparison only.</li>
    <li>This is an illustration, not an engineering calculation. Never exceed the capacity marked on the plate or the jack, and support a raised load with stands or cribbing before working under it.</li>
  </ul>
</div>
<style>
  .bk-ls {
    --bg: #f1f2f1;
    --panel: #ffffff;
    --ink: #121314;
    --muted: #5d6268;
    --line: #d5d8da;
    --soil: #9a7a58;
    --soil-deep: #7d6145;
    --grain: #5f4732;
    --steel: #6c737b;
    --rail: #2b2f33;
    --jack: #c4342b;
    --plate: #18191b;
    --plate-edge: #000000;
    --hot: #e2551b;
    --sleeve: #2563c9;
    --rope: #f4f1e8;
    --hi: #f2b705;
    --font-display: var(--font-heading--family, "Oswald"), "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
    --font-body: var(--font-body--family, "Barlow"), "Helvetica Neue", Arial, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  }
  *:has(> .bk-ls) { min-width: 0; max-width: 100%; }
  .bk-ls { width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box; display: flex; flex-direction: column; gap: 16px; padding-top: 8px; border-top: 1px solid rgba(0,0,0,0.15); color: var(--ink); font-family: var(--font-body); }
  .bk-ls * { box-sizing: border-box; }
  .bk-ls__title { margin: 12px 0 0; }
  .bk-ls__lede { margin: 0; color: var(--muted); max-width: 64ch; }
  @media (max-width: 560px) { .bk-ls .scenes { margin-left: 0; } }
.bk-ls .stage { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .bk-ls .stage svg { display: block; width: 100%; height: auto; max-width: 100%; }
  .bk-ls .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; padding: 12px 14px; border-top: 1px solid var(--line); }
  .bk-ls .controls { display: flex; gap: 8px; }
  .bk-ls .scenes { display: flex; flex-wrap: wrap; gap: 6px; margin-left: auto; }
  .bk-ls button { font: 600 0.82rem/1 var(--font-body); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); background: transparent; border: 1px solid var(--ink); border-radius: 0; padding: 10px 14px; cursor: pointer; }
  .bk-ls button:hover { background: var(--ink); color: var(--panel); }
  .bk-ls button[aria-pressed="true"] { background: var(--ink); color: var(--panel); }
  .bk-ls button:focus-visible { outline: 3px solid var(--hi); outline-offset: 2px; }
  .bk-ls .progress { flex: 1 1 100%; height: 3px; background: var(--line); position: relative; order: 3; }
  .bk-ls .progress span { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--hot); }
  .bk-ls .caption { min-height: 4.6em; margin: 0; padding: 16px 18px; border-left: 4px solid var(--hot); background: var(--panel); font-size: 1.06rem; max-width: 100%; }
  .bk-ls .caption strong { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; display: block; font-size: 0.95rem; margin-bottom: 2px; }
  .bk-ls h2 { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; font-size: 1.35rem; margin: 12px 0 0; }
  .bk-ls .tablewrap { overflow-x: auto; border: 1px solid var(--line); background: var(--panel); }
  .bk-ls table { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 0.95rem; }
  .bk-ls th { text-align: left; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.75rem; background: var(--ink); color: var(--panel); padding: 10px 12px; white-space: nowrap; }
  .bk-ls td { padding: 10px 12px; border-top: 1px solid var(--line); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .bk-ls td.num { font-family: var(--font-mono); text-align: right; }
  .bk-ls th.num { text-align: right; }
  .bk-ls tr.ref td { color: var(--muted); }
  .bk-ls tr.grp th { background: var(--bg); color: var(--ink); text-align: left; font-size: 0.75rem; letter-spacing: 0.06em; padding: 10px 12px; border-top: 2px solid var(--ink); white-space: normal; }
  .bk-ls .notes { margin: 0; padding-left: 1.2em; color: var(--muted); font-size: 0.9rem; display: grid; gap: 6px; max-width: 80ch; }

  /* SVG classes */
  .bk-ls .t-display { font-family: var(--font-display); font-weight: 600; text-transform: uppercase; fill: var(--ink); }
  .bk-ls .t-body { font-family: var(--font-body); fill: var(--ink); }
  .bk-ls .t-muted { font-family: var(--font-body); fill: var(--muted); }
  .bk-ls .t-mono { font-family: var(--font-mono); fill: var(--muted); }
  .bk-ls .t-hot { fill: var(--hot); }
  .bk-ls .f-soil { fill: var(--soil); }
  .bk-ls .f-grain { fill: var(--grain); }
  .bk-ls .s-strata { stroke: var(--soil-deep); stroke-width: 2; fill: none; opacity: 0.6; }
  .bk-ls .f-hot { fill: var(--hot); }
  .bk-ls .s-hot { stroke: var(--hot); }
  .bk-ls .f-jack { fill: var(--jack); }
  .bk-ls .f-steel { fill: var(--steel); }
  .bk-ls .f-rail { fill: var(--rail); }
  .bk-ls .f-plate { fill: var(--plate); stroke: var(--plate-edge); stroke-width: 2; }
  .bk-ls .s-ink { stroke: var(--ink); fill: none; }
  .bk-ls .f-ink { fill: var(--ink); }
  .bk-ls .s-line { stroke: var(--line); }
  .bk-ls .s-muted { stroke: var(--muted); }
  .bk-ls .f-sleeve { fill: none; stroke: var(--sleeve); stroke-width: 9; stroke-linecap: round; }
  .bk-ls .s-rope { fill: none; stroke: var(--rope); stroke-width: 5; stroke-linecap: round; }
  .bk-ls .s-rope-edge { fill: none; stroke: var(--muted); stroke-width: 7; stroke-linecap: round; }
  .bk-ls .f-panel { fill: var(--panel); }
    .bk-ls .bk-ls__sub { margin: 4px 0 0; }
  .bk-ls .tablewrap table { margin: 0; }

  @media (min-width: 750px) { .bk-ls.bk-ls { width: 75%; max-width: 75%; margin-inline: auto; } }
</style>
<script>

(function () {
  var SUF = '-{{ block.id }}';
  var ROOT = document.getElementById('bk-ls' + SUF);
  if (!ROOT || ROOT.dataset.init) return; ROOT.dataset.init = '1';
  var NS = 'http://www.w3.org/2000/svg';
  var G = 440, CX = 600, LOAD = 5000;
  var JACK_PSI = LOAD / 42, PLATE_PSI = LOAD / 144;
  var SCENES = [0, 9500, 19000, 30000];
  var CAPTIONS = [
    ['Without a plate', 'A 5,000 lb load on a 6 × 7 in jack base puts about 119 psi on the ground. Soft soil can’t carry that, so the base punches in and the jack tips.'],
    ['With a 12 × 12 Bedrock plate', 'The same load spreads over 144 sq in, about 35 psi. That is 3.4 times less pressure, and the jack stays level.'],
    ['Size the plate to the ground', 'Bigger plates spread it further. On gravel, an 18 × 18 plate gets under the code bearing value; on soft clay it takes a 24 × 24.']
  ];

  function el(tag, attrs, parent) {
    var e = document.createElementNS(NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    if (parent) parent.appendChild(e);
    return e;
  }
  function $(id) { return document.getElementById(id + SUF); }
  function clamp(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
  function ease(x) { x = clamp(x); return x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2; }

  // Static soil texture
  var seed = 7;
  function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }
  var strata = $('strata');
  [500, 560, 615].forEach(function (y, i) {
    el('path', { d: 'M0 ' + y + ' C 300 ' + (y - 10 + i * 6) + ', 700 ' + (y + 12) + ', 1200 ' + (y - 4), 'class': 's-strata' }, strata);
  });
  var grains = $('grains');
  for (var i = 0; i < 320; i++) {
    el('circle', { cx: (rnd() * 1200).toFixed(1), cy: (G - 30 + rnd() * 230).toFixed(1), r: (1.2 + rnd() * 2.6).toFixed(1), 'class': 'f-grain', opacity: (0.35 + rnd() * 0.5).toFixed(2) }, grains);
  }

  // Pressure bulb contours
  var bulb = $('bulb');
  var contours = [];
  for (var k = 5; k >= 1; k--) contours.push({ k: k, node: el('path', { 'class': 'f-hot' }, bulb) });
  var pArrows = $('pArrows');
  var arrowNodes = [];
  for (var a = 0; a < 9; a++) arrowNodes.push(el('line', { 'class': 's-hot', 'stroke-width': 5, 'marker-end': 'url(#ah' + SUF + ')', 'stroke-linecap': 'butt' }, pArrows));

  function soilPath(s) {
    var d = s * 30, h = s * 14;
    return 'M0 ' + G + ' H' + (CX - 150) + ' Q' + (CX - 125) + ' ' + (G - h) + ' ' + (CX - 100) + ' ' + G +
      ' L' + (CX - 72) + ' ' + (G + d) + ' L' + (CX + 72) + ' ' + (G + d) + ' L' + (CX + 100) + ' ' + G +
      ' Q' + (CX + 125) + ' ' + (G - h) + ' ' + (CX + 150) + ' ' + G + ' H1200 V640 H0 Z';
  }

  function drawBulb(width, topY, intensity, p) {
    contours.forEach(function (c) {
      var rx = (width / 2) * (0.75 + 0.5 * c.k) * (0.4 + 0.6 * p);
      var ry = width * 0.3 * c.k * p + 0.01;
      c.node.setAttribute('d', 'M' + (CX - rx) + ' ' + topY + ' A' + rx + ' ' + ry + ' 0 0 0 ' + (CX + rx) + ' ' + topY + ' Z');
      c.node.setAttribute('opacity', (p * intensity * (0.22 + 0.12 * (6 - c.k)) / 1.0).toFixed(3));
    });
  }
  function drawArrows(width, topY, psi, p, count) {
    var len = 12 + 60 * (psi / JACK_PSI);
    arrowNodes.forEach(function (n, i) {
      if (i >= count || p <= 0) { n.setAttribute('opacity', 0); return; }
      var x = count === 1 ? CX : CX - width / 2 + 10 + (width - 20) * i / (count - 1);
      n.setAttribute('x1', x); n.setAttribute('x2', x);
      n.setAttribute('y1', topY + 6); n.setAttribute('y2', topY + 6 + len * p);
      n.setAttribute('opacity', p.toFixed(2));
    });
  }

  function renderAB(mode, u) {
    var pa = ease(u / 1200);
    var p = ease((u - 1200) / 2600);
    var s = mode === 0 ? ease((u - 4300) / 2200) : 0;
    var plateA = mode === 1 ? ease(u / 700) : 0;
    var lift = mode === 1 ? 30 * plateA : 0;

    var sp = soilPath(s);
    $('soil').setAttribute('d', sp);
    $('soilClipPath').setAttribute('d', sp);
    $('plateG').setAttribute('opacity', plateA.toFixed(2));
    $('baseCallout').setAttribute('opacity', mode === 0 ? 1 : 0);

    var jackT = 'translate(0 ' + (s * 30 - lift).toFixed(2) + ') rotate(' + (s * 6).toFixed(2) + ' ' + CX + ' ' + G + ')';
    $('jack').setAttribute('transform', jackT);
    $('rail').setAttribute('transform', 'translate(0 ' + (s * 22 - lift).toFixed(2) + ')');
    $('loadArrow').setAttribute('transform', 'translate(0 ' + ((1 - pa) * -60 + s * 22 - lift).toFixed(2) + ')');
    $('loadArrow').setAttribute('opacity', pa.toFixed(2));

    var psiVal = mode === 0 ? JACK_PSI : PLATE_PSI;
    var width = mode === 0 ? 140 : 240;
    var topY = mode === 0 ? G + s * 30 : G;
    var intensity = 0.2 + 0.8 * (psiVal / JACK_PSI);
    drawBulb(width, topY, intensity, p);
    drawArrows(width, topY, psiVal, p, mode === 0 ? 5 : 9);

    $('sceneLabel').textContent = mode === 0 ? 'Without a plate' : 'With a 12 × 12 Bedrock plate';
    $('psi').textContent = Math.round(psiVal * p) + ' psi';
    $('formula').textContent = mode === 0 ? '5,000 lb ÷ 42 sq in' : '5,000 lb ÷ 144 sq in';
    $('warn').setAttribute('opacity', mode === 0 ? clamp((s - 0.5) * 3).toFixed(2) : 0);
    $('ok').setAttribute('opacity', mode === 1 ? clamp((u - 4200) / 700).toFixed(2) : 0);
  }

  // Chart (scene C), log scale 5..150 psi
  var chart = $('chart');
  var X0 = 380, XW = 740, LMIN = Math.log(5), LMAX = Math.log(150);
  function xs(v) { return X0 + XW * (Math.log(v) - LMIN) / (LMAX - LMIN); }
  [5, 10, 20, 50, 100].forEach(function (t) {
    el('line', { x1: xs(t), x2: xs(t), y1: 200, y2: 560, 'class': 's-line', 'stroke-width': 1 }, chart);
    var tx = el('text', { x: xs(t), y: 590, 'text-anchor': 'middle', 'class': 't-mono', 'font-size': 20 }, chart); tx.textContent = t + ' psi';
  });
  var refs = [[10.4, 'Clay 10.4', 270], [13.9, 'Sand 13.9', 236], [20.8, 'Gravel 20.8', 202]];
  refs.forEach(function (r) {
    el('line', { x1: xs(r[0]), x2: xs(r[0]), y1: r[2] - 22, y2: 560, 'class': 's-muted', 'stroke-width': 2, 'stroke-dasharray': '6 6' }, chart);
  });
  refs.forEach(function (r) {
    var bg = el('rect', { 'class': 'f-panel' }, chart);
    var t = el('text', { x: xs(r[0]) + 8, y: r[2] - 4, 'class': 't-muted', 'font-size': 19 }, chart); t.textContent = r[1];
    fitBg(bg, t);
  });
  function fitBg(bg, t) {
    try { var b = t.getBBox(); bg.setAttribute('x', b.x - 4); bg.setAttribute('y', b.y - 2); bg.setAttribute('width', b.width + 8); bg.setAttribute('height', b.height + 4); } catch (e) {}
  }
  var rows = [
    { label: 'Jack base only', sub: '42 sq in', v: JACK_PSI, hot: true },
    { label: '12 × 12 plate', sub: '144 sq in', v: LOAD / 144 },
    { label: '18 × 18 plate', sub: '324 sq in', v: LOAD / 324 },
    { label: '24 × 24 plate', sub: '576 sq in', v: LOAD / 576 }
  ];
  rows.forEach(function (r, i) {
    var y = 300 + i * 66;
    var l = el('text', { x: 40, y: y + 8, 'class': 't-display', 'font-size': 26 }, chart); l.textContent = r.label;
    var sb = el('text', { x: 40, y: y + 34, 'class': 't-muted', 'font-size': 19 }, chart); sb.textContent = r.sub;
    r.bar = el('rect', { x: X0, y: y - 16, height: 34, width: 0, 'class': r.hot ? 'f-hot' : 'f-ink' }, chart);
    r.bg = el('rect', { 'class': 'f-panel' }, chart);
    r.val = el('text', { y: y + 10, 'class': 't-display', 'font-size': 24 }, chart);
  });
  function renderC(u) {
    rows.forEach(function (r, i) {
      var g = ease((u - 500 - i * 900) / 900);
      var w = (xs(r.v) - X0) * g;
      r.bar.setAttribute('width', Math.max(0, w).toFixed(1));
      r.val.setAttribute('x', (X0 + w + 10).toFixed(1));
      r.val.textContent = g > 0 ? (r.v * g).toFixed(1) + ' psi' : '';
      if (g > 0) fitBg(r.bg, r.val); else r.bg.setAttribute('width', 0);
    });
  }

  // Timeline
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var t = 0, playing = !reduce, last = null, curScene = -1;
  var playBtn = $('playBtn'), prog = $('prog'), cap = $('caption');
  var sceneBtns = Array.prototype.slice.call(ROOT.querySelectorAll('[data-scene]'));

  function sceneOf(time) { return time < SCENES[1] ? 0 : time < SCENES[2] ? 1 : 2; }
  function render(time) {
    var sc = sceneOf(time);
    var u = time - SCENES[sc];
    $('sceneAB').setAttribute('opacity', sc < 2 ? 1 : 0);
    $('sceneC').setAttribute('opacity', sc === 2 ? 1 : 0);
    if (sc < 2) renderAB(sc, u); else renderC(u);
    if (sc !== curScene) {
      curScene = sc;
      cap.innerHTML = '<strong>' + CAPTIONS[sc][0] + '</strong>' + CAPTIONS[sc][1];
      sceneBtns.forEach(function (b) { b.setAttribute('aria-pressed', String(+b.dataset.scene === sc)); });
    }
    prog.style.width = (100 * time / SCENES[3]).toFixed(2) + '%';
  }
  function frame(ts) {
    if (playing) {
      if (last !== null) t += Math.min(ts - last, 100);
      if (t >= SCENES[3]) t = 0;
      render(t);
    }
    last = ts;
    requestAnimationFrame(frame);
  }
  function setPlaying(v) {
    playing = v;
    playBtn.textContent = v ? 'Pause' : 'Play';
    playBtn.setAttribute('aria-label', v ? 'Pause' : 'Play');
  }
  playBtn.addEventListener('click', function () { setPlaying(!playing); });
  $('replayBtn').addEventListener('click', function () { t = 0; render(t); if (!reduce) setPlaying(true); });
  sceneBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      var sc = +b.dataset.scene;
      if (reduce) { t = SCENES[sc + 1] - 1; render(t); return; }
      t = SCENES[sc]; render(t); setPlaying(true);
    });
  });

  // Resting state: a fully drawn first scene for thumbnails and reduced motion.
  t = reduce ? SCENES[1] - 1 : 0;
  render(reduce ? t : 8000);
  setPlaying(!reduce);
  if (!reduce) { render(0); }
  requestAnimationFrame(frame);
})();
</script>
{%- endif -%}
