{%- liquid
  assign p = closest.product
  if p == blank
    assign p = product
  endif
  assign show = false
  if p != blank and p.type == 'Cribbing Block'
    assign show = true
  endif
  if collection.handle == 'cribbing-blocks' or collection.handle == 'cribbing-kits'
    assign show = true
  endif
-%}
{%- if show -%}
{%- render 'crib-lift-styles' -%}
<div class="bk-lp" id="bk-lp-{{ block.id }}" {{ block.shopify_attributes }}>
  <h3 class="bk-lp__title">{{ block.settings.heading | escape }}</h3>
  <p class="bk-lp__lede">Large equipment often lifts from points far above a jack's reach. A Brakko crib stack builds a solid, level platform to set a 55 or 100 ton aluminum jack on.</p>
<section class="stage" aria-label="Animated crib lift platform explainer">
    <svg id="svg-{{ block.id }}" viewBox="0 0 1200 720" role="img" aria-labelledby="svgDesc-{{ block.id }}">
      <desc id="svgDesc-{{ block.id }}">Side view of a large machine with a lift point 65 inches off the ground. An aluminum jack on the ground reaches only 18 inches. A crib of 6 by 7 by 24 inch blocks is stacked to 52 inches, the jack sits on top and lifts the machine. A ruler shows the 72 inch maximum, three times the 24 inch block length, and a ghosted stack above it shows what not to build.</desc>
      <defs>
        <marker id="ah-{{ block.id }}" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="3" markerHeight="3" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="f-hot"/></marker>
        <marker id="ahI-{{ block.id }}" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="f-ink"/></marker>
        <pattern id="pyr-{{ block.id }}" width="8" height="8" patternUnits="userSpaceOnUse"><rect width="8" height="8" class="f-block"/><rect x="1.4" y="1.4" width="5.2" height="5.2" class="f-block-hi"/></pattern>
      </defs>

      <g id="ground-{{ block.id }}">
        <rect x="0" y="650" width="1200" height="70" class="f-soil"/>
        <g id="grains-{{ block.id }}"></g>
      </g>

      <g id="machine-{{ block.id }}">
        <g id="tire-{{ block.id }}">
          <circle cx="150" cy="414" r="236" class="f-tire"/>
          <circle cx="150" cy="414" r="214" class="s-tread" stroke-width="10" stroke-dasharray="26 18"/>
          <circle cx="150" cy="414" r="120" class="f-rail"/>
          <circle cx="150" cy="414" r="96" class="f-steel"/>
          <circle cx="150" cy="414" r="30" class="f-rail"/>
        </g>
        <rect x="320" y="70" width="500" height="120" rx="6" class="f-machine"/>
        <rect x="320" y="70" width="500" height="16" class="f-machine-dk"/>
        <rect x="150" y="190" width="640" height="47" rx="4" class="f-machine-dk"/>
        <rect x="660" y="237" width="80" height="10" class="f-rail"/>
        <g id="liftMark-{{ block.id }}">
          <path d="M654 242 l -16 -9 v 18 z" class="f-hi"/>
          <text x="630" y="250" text-anchor="end" class="t-display" font-size="22">Lift point</text>
        </g>
      </g>

      <g id="ruler-{{ block.id }}"></g>
      <g id="maxLine-{{ block.id }}" opacity="0">
        <line x1="590" y1="0" x2="880" y2="0" class="s-hot" stroke-width="3" stroke-dasharray="10 7"/>
        <text x="886" y="-6" class="t-display t-hot" font-size="24">72 in max</text>
        <text x="886" y="20" class="t-muted" font-size="18">3 × 24 in block length</text>
      </g>

      <g id="ghost-{{ block.id }}" opacity="0"></g>
      <g id="crib-{{ block.id }}"></g>
      <g id="jack-{{ block.id }}"></g>

      <g id="gapDim-{{ block.id }}" opacity="0">
        <line x1="560" y1="0" x2="560" y2="0" class="s-hot" stroke-width="4" marker-start="url(#ah-{{ block.id }})" marker-end="url(#ah-{{ block.id }})"/>
        <text x="548" y="0" text-anchor="end" class="t-display t-hot" font-size="30">47 in short</text>
      </g>

      <g id="ratio-{{ block.id }}" opacity="0">
        <line x1="624" y1="672" x2="776" y2="672" class="s-ink" stroke-width="2" marker-start="url(#ahI-{{ block.id }})" marker-end="url(#ahI-{{ block.id }})"/>
        <text x="700" y="700" text-anchor="middle" class="t-display" font-size="20">24 in</text>
      </g>

      <text id="sceneLabel-{{ block.id }}" x="40" y="44" class="t-display" font-size="30"></text>
      <g id="readout-{{ block.id }}">
        <text id="roLabel-{{ block.id }}" x="1170" y="380" text-anchor="end" class="t-muted" font-size="20" letter-spacing="2"></text>
        <text id="roBig-{{ block.id }}" x="1170" y="456" text-anchor="end" class="t-display" font-size="76"></text>
        <text id="roSub-{{ block.id }}" x="1170" y="492" text-anchor="end" class="t-mono" font-size="18"></text>
        <text id="roNote-{{ block.id }}" x="1170" y="540" text-anchor="end" class="t-display" font-size="28"></text>
      </g>
    </svg>
    <div class="bar">
      <div class="controls">
        <button id="playBtn-{{ block.id }}" type="button" aria-label="Pause">Pause</button>
        <button id="replayBtn-{{ block.id }}" type="button">Replay</button>
      </div>
      <div class="scenes" role="group" aria-label="Jump to scene">
        <button type="button" data-scene="0" aria-pressed="true">The gap</button>
        <button type="button" data-scene="1" aria-pressed="false">Build it</button>
        <button type="button" data-scene="2" aria-pressed="false">Lift</button>
        <button type="button" data-scene="3" aria-pressed="false">3:1 rule</button>
      </div>
      <div class="progress" aria-hidden="true"><span id="prog-{{ block.id }}"></span></div>
    </div>
  </section>

  <p class="caption" id="caption-{{ block.id }}" aria-live="polite"></p>

  <h4 class="bk-lp__sub">Plan your stack</h4>
  <div class="calc">
    <label>Lift point height <span class="hint">inches from the ground</span><input id="inLift-{{ block.id }}" type="number" min="10" max="120" step="0.5" value="65" inputmode="decimal"></label>
    <label>Jack closed height <span class="hint">check your jack's spec sheet</span><input id="inClosed-{{ block.id }}" type="number" min="4" max="40" step="0.25" value="12" inputmode="decimal"></label>
    <label>Jack stroke <span class="hint">inches of travel</span><input id="inStroke-{{ block.id }}" type="number" min="1" max="30" step="0.25" value="6" inputmode="decimal"></label>
  </div>
  <div class="result" id="result-{{ block.id }}" aria-live="polite"><span class="big" id="rBig-{{ block.id }}"></span><span class="sub" id="rSub-{{ block.id }}"></span></div>

  <ul class="notes">
    <li>Stack shown: a 24 × 24 × 2 in Anchor base plate, eight crossing layers of three Bedrock 6 × 7 × 24 in blocks (6 in per layer) and a 2 in locking top plate, 52 in tall in all.</li>
    <li>The 3:1 rule: keep the crib no taller than 3 × the block length. With 24 in blocks that is 72 in, measured from the ground to the top of the crib.</li>
    <li>The jack figures are an example of a 12 in closed, 6 in stroke aluminum jack. 55 and 100 ton jacks vary, so use your jack's closed height and stroke in the planner.</li>
    <li>Set the jack in the center of the top plate, square under the lift point. Build on firm, level ground, crib up behind the load as it rises, and never work under a load held only by a jack.</li>
    <li>The crib's rated capacity must be greater than the load. This is an illustration, not an engineering calculation; follow the crib manual and your equipment maker's lift-point guidance.</li>
  </ul>
</div>
<script>
(function () {
  var SUF = '-{{ block.id }}';
  var WRAP = document.getElementById('bk-lp' + SUF);
  var ROOT = document.getElementById('svg' + SUF);
  if (!ROOT || ROOT.dataset.init) return; ROOT.dataset.init = '1';
  var NS = 'http://www.w3.org/2000/svg';
  var G = 650, PX = 6.2, CX = 700, LIFT = 65, CLOSED = 12, STROKE = 6, LAYER = 6, PLATE = 2, NL = 8, MAXH = 72;
  var W24 = 24 * PX, BW = 7 * PX, x0 = CX - W24 / 2;
  var SCENES = [0, 7500, 18000, 26500, 35500];
  var CAPTIONS = [
    ['The gap', 'This machine lifts from a point 65 in off the ground. Even fully extended, an aluminum jack sitting on the ground tops out around 18 in. It is 47 in short.'],
    ['Build the platform', 'Crib up under the lift point: an Anchor base plate, crossing layers of 6 × 7 × 24 in blocks, and a locking top plate. Eight layers make a 52 in platform, still well under the 72 in limit.'],
    ['Lift from the stack', 'Set a 55 or 100 ton aluminum jack in the center of the top plate. The jack starts just under the lift point and its full stroke goes into lifting, not reaching. Crib up behind the load as it rises.'],
    ['The 3:1 rule', 'Never build a crib taller than 3 times the block length. With 24 in blocks the limit is 72 in. Past that, a narrow stack gets top-heavy and can tip. Need more height? Use a taller jack, not a taller stack.']
  ];

  function el(tag, attrs, parent) { var e = document.createElementNS(NS, tag); for (var k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; }
  function $(id) { return document.getElementById(id + SUF); }
  function clamp(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
  function ease(x) { x = clamp(x); return x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2; }
  function Y(inch) { return G - inch * PX; }

  var seed = 7; function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }
  for (var i = 0; i < 140; i++) el('circle', { cx: (rnd() * 1200).toFixed(1), cy: (G + 6 + rnd() * 60).toFixed(1), r: (1 + rnd() * 2.2).toFixed(1), 'class': 'f-grain', opacity: (0.35 + rnd() * 0.5).toFixed(2) }, $('grains'));

  // ruler
  var ru = $('ruler'), RX = 800;
  el('line', { x1: RX, y1: G, x2: RX, y2: Y(MAXH + 6), 'class': 's-muted', 'stroke-width': 2 }, ru);
  for (var r = 0; r <= MAXH; r += 6) {
    var big = r % 12 === 0;
    el('line', { x1: RX, y1: Y(r), x2: RX + (big ? 16 : 9), y2: Y(r), 'class': 's-muted', 'stroke-width': 2 }, ru);
    if (big && r > 0) { var tt = el('text', { x: RX + 22, y: Y(r) + 6, 'class': 't-mono', 'font-size': 16 }, ru); tt.textContent = r + ' in'; }
  }
  $('maxLine').setAttribute('transform', 'translate(0 ' + Y(MAXH) + ')');

  // crib pieces, bottom up; each item: {g, top}
  var crib = $('crib'), pieces = [], y = G;
  function plateAt(yb, isTop) {
    var g = el('g', {}, crib);
    el('rect', { x: x0 - 4, y: yb - PLATE * PX, width: W24 + 8, height: PLATE * PX, rx: 3, 'class': 'f-plate' }, g);
    if (isTop) for (var k = 0; k < 3; k++) el('rect', { x: x0 + 6 + k * (W24 / 3), y: yb - PLATE * PX, width: W24 / 3 - 12, height: 3, 'class': 'f-slot' }, g);
    return g;
  }
  function endOnAt(yb) {
    var g = el('g', {}, crib), gap = (W24 - 3 * BW) / 2;
    for (var k = 0; k < 3; k++) {
      var bx = x0 + k * (BW + gap);
      el('rect', { x: bx, y: yb - LAYER * PX, width: BW, height: LAYER * PX, rx: 2, 'class': 'f-block' }, g);
      el('rect', { x: bx, y: yb - LAYER * PX, width: BW, height: 4, fill: 'url(#pyr' + SUF + ')' }, g);
      el('rect', { x: bx + 7, y: yb - LAYER * PX + 9, width: BW - 14, height: 9, rx: 4.5, 'class': 'f-slot' }, g);
      el('path', { d: 'M' + (bx + 9) + ' ' + (yb - 10) + ' q ' + (BW / 2 - 9) + ' 12 ' + (BW - 18) + ' 0', 'class': 'f-grip', 'stroke-width': 4 }, g);
    }
    return g;
  }
  function longAt(yb) {
    var g = el('g', {}, crib);
    el('rect', { x: x0, y: yb - LAYER * PX, width: W24, height: LAYER * PX, rx: 2, fill: 'url(#pyr' + SUF + ')' }, g);
    [[0, 1.42], [7.62, 8.73], [14.93, 16.04], [22.58, 24]].forEach(function (q) { el('rect', { x: x0 + q[0] * PX, y: yb - LAYER * PX, width: (q[1] - q[0]) * PX, height: LAYER * PX, 'class': 'f-block' }, g); });
    el('rect', { x: x0, y: yb - LAYER * PX, width: W24, height: LAYER * PX, rx: 2, 'class': 's-blockedge' }, g);
    return g;
  }
  pieces.push({ g: plateAt(y, false), h: PLATE }); y -= PLATE * PX;
  for (var L = 0; L < NL; L++) { pieces.push({ g: (L % 2 ? longAt(y) : endOnAt(y)), h: LAYER }); y -= LAYER * PX; }
  pieces.push({ g: plateAt(y, true), h: PLATE });
  var STACK = PLATE * 2 + NL * LAYER; // 52

  // ghost layers above the limit
  var gh = $('ghost');
  for (var gL = 0; gL < 4; gL++) {
    var gy = Y(STACK + gL * LAYER);
    el('rect', { x: x0, y: gy - LAYER * PX, width: W24, height: LAYER * PX, 'class': 'f-ghost' }, gh);
    el('rect', { x: x0, y: gy - LAYER * PX, width: W24, height: LAYER * PX, 'class': 's-ghost' }, gh);
  }
  el('text', { x: x0 - 14, y: Y(STACK + 13), 'text-anchor': 'end', 'class': 't-display t-hot', 'font-size': 26 }, gh).textContent = 'Too tall';
  el('text', { x: x0 - 14, y: Y(STACK + 13) + 26, 'text-anchor': 'end', 'class': 't-muted', 'font-size': 18 }, gh).textContent = '76 in on a 24 in base';

  // jack (aluminum)
  var jack = $('jack'), jBase = el('g', {}, jack), ram = el('g', {}, jack);
  var JW = 9 * PX, JH = CLOSED * PX;
  el('rect', { x: -JW / 2, y: -1.6 * PX, width: JW, height: 1.6 * PX, rx: 3, 'class': 'f-alu-dk' }, jBase);
  el('rect', { x: -JW / 2 + 6, y: -JH + 2 * PX, width: JW - 12, height: JH - 3.6 * PX, rx: 4, 'class': 'f-alu' }, jBase);
  el('rect', { x: -JW / 2 + 6, y: -JH + 2 * PX, width: JW - 12, height: 6, 'class': 'f-alu-dk' }, jBase);
  el('rect', { x: JW / 2 - 6, y: -4 * PX, width: 14, height: 18, rx: 2, 'class': 'f-alu-dk' }, jBase);
  var ramShaft = el('rect', { x: -2.4 * PX, y: 0, width: 4.8 * PX, height: 0, 'class': 'f-steel' }, ram);
  var saddle = el('rect', { x: -3.4 * PX, y: 0, width: 6.8 * PX, height: 2 * PX, rx: 3, 'class': 'f-alu-dk' }, ram);
  var tonTxt = el('text', { x: 0, y: -JH / 2 + 8, 'text-anchor': 'middle', 'class': 't-display', 'font-size': 18 }, jBase); tonTxt.textContent = '55 T';

  function placeJack(baseIn, ext, op) {
    var by = Y(baseIn);
    jack.setAttribute('transform', 'translate(' + CX + ' ' + by + ')');
    jack.setAttribute('opacity', op);
    var top = -JH - ext * PX;            // saddle top relative to base
    saddle.setAttribute('y', top);
    ramShaft.setAttribute('y', top + 2 * PX); ramShaft.setAttribute('height', Math.max(0, -JH + 2 * PX - (top + 2 * PX) + 4));
    return baseIn + CLOSED + ext;        // jack top, inches
  }

  var ro = { l: $('roLabel'), b: $('roBig'), s: $('roSub'), n: $('roNote') };
  function readout(l, b, s, n, hot) { ro.l.textContent = l; ro.b.textContent = b; ro.s.textContent = s; ro.n.textContent = n; ro.n.setAttribute('class', 't-display' + (hot ? ' t-hot' : '')); }

  function render(t) {
    var sc = 0; while (sc < 3 && t >= SCENES[sc + 1]) sc++;
    var u = t - SCENES[sc];
    $('sceneLabel').textContent = CAPTIONS[sc][0];
    var lift = 0, crN = 0, jackOp = 1, gapOp = 0, maxOp = 0, ghostOp = 0, ratioOp = 0;
    if (sc === 0) {
      var ext = STROKE * ease((u - 1200) / 2200);
      var top = placeJack(0, ext, 1);
      gapOp = clamp((u - 3600) / 600);
      var gd = $('gapDim'), ln = gd.querySelector('line'), tx = gd.querySelector('text');
      ln.setAttribute('y1', Y(top) - 4); ln.setAttribute('y2', Y(LIFT) + 22); tx.setAttribute('y', (Y(top) + Y(LIFT)) / 2 + 10);
      readout('JACK REACH', Math.round(top) + ' in', CLOSED + ' closed + ' + STROKE + ' stroke', u > 3600 ? 'Lift point is 65 in' : '', u > 3600);
    } else if (sc === 1) {
      jackOp = 0; placeJack(0, 0, 0);
      crN = Math.min(pieces.length, Math.floor((u - 300) / 850) + 1);
      if (u < 300) crN = 0;
      var h = 0; for (var k = 0; k < crN; k++) h += pieces[k].h;
      maxOp = clamp((u - 500) / 600);
      readout('STACK HEIGHT', h + ' in', Math.max(0, crN - 2) + ' layers · ' + 3 * Math.max(0, Math.min(NL, crN - 1)) + ' blocks', crN >= pieces.length ? 'Under the 72 in limit' : '', false);
    } else if (sc === 2) {
      crN = pieces.length; maxOp = 0.35;
      var drop = ease(u / 900);
      var ext2 = STROKE * ease((u - 1200) / 3800);
      var contact = LIFT - STACK - CLOSED;           // 1 in
      lift = Math.max(0, ext2 - contact);
      var jt = placeJack(STACK + (1 - drop) * 10, ext2, drop);
      readout('LIFT POINT', (LIFT + lift).toFixed(0) + ' in', STACK + ' crib + ' + CLOSED + ' jack + lift', lift > 0 ? 'Raised ' + lift.toFixed(1) + ' in' : 'Jack under the lift point', false);
    } else {
      crN = pieces.length; maxOp = 1;
      placeJack(STACK, 0, clamp(1 - u / 500));
      ghostOp = clamp((u - 800) / 700) * (u < 6500 ? 1 : clamp(1 - (u - 6500) / 600));
      ratioOp = clamp((u - 2600) / 600);
      readout('MAX CRIB HEIGHT', '72 in', '3 × 24 in block length', u > 800 && u < 7100 ? 'Taller can tip' : 'Need more? Taller jack', u > 800 && u < 7100);
    }
    pieces.forEach(function (p, k) { p.g.setAttribute('opacity', k < crN ? 1 : 0); });
    $('machine').setAttribute('transform', 'translate(0 ' + (-lift * PX).toFixed(1) + ')');
    $('machine').setAttribute('opacity', sc === 3 ? (1 - 0.8 * clamp(u / 700)).toFixed(2) : 1);
    $('gapDim').setAttribute('opacity', gapOp);
    $('maxLine').setAttribute('opacity', maxOp);
    $('ruler').setAttribute('opacity', sc === 0 ? 0.5 : 1);
    $('ghost').setAttribute('opacity', ghostOp);
    $('liftMark').setAttribute('opacity', sc === 3 ? 0 : 1);
    $('ratio').setAttribute('opacity', ratioOp);
    $('caption').innerHTML = '<strong>' + CAPTIONS[sc][0] + '</strong>' + CAPTIONS[sc][1];
    WRAP.querySelectorAll('[data-scene]').forEach(function (b) { b.setAttribute('aria-pressed', String(+b.dataset.scene === sc)); });
    $('prog').style.width = (100 * t / SCENES[4]).toFixed(2) + '%';
  }

  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var t = 0, playing = !reduce, last = null, shownScene = -1;
  function frame(ts) {
    if (last === null) last = ts;
    if (playing) { t += ts - last; if (t >= SCENES[4]) t = 0; render(t); }
    last = ts; requestAnimationFrame(frame);
  }
  function setPlay(p) { playing = p; $('playBtn').textContent = p ? 'Pause' : 'Play'; $('playBtn').setAttribute('aria-label', p ? 'Pause' : 'Play'); }
  $('playBtn').addEventListener('click', function () { setPlay(!playing); });
  $('replayBtn').addEventListener('click', function () { t = 0; render(0); setPlay(true); });
  WRAP.querySelectorAll('[data-scene]').forEach(function (b) {
    b.addEventListener('click', function () { var s = +b.dataset.scene; t = SCENES[s] + [6000, 9500, 7000, 4500][s]; render(t); setPlay(false); });
  });
  setPlay(playing);
  render(reduce ? SCENES[2] + 6000 : 0);
  requestAnimationFrame(frame);

  // planner
  function calc() {
    var lp = parseFloat($('inLift').value), cl = parseFloat($('inClosed').value), st = parseFloat($('inStroke').value);
    var res = $('result'), rb = $('rBig'), rs = $('rSub');
    if (!(lp > 0 && cl > 0 && st > 0)) { rb.textContent = 'Enter all three numbers'; rs.textContent = ''; res.className = 'result'; return; }
    if (lp - cl <= st) { rb.textContent = 'No crib needed'; rs.textContent = 'The jack reaches ' + (cl + st) + ' in from the ground. Set it on a jack plate.'; res.className = 'result'; return; }
    // tallest stack that still lets the closed jack fit under the lift point
    var room = lp - cl - 2 * PLATE;
    var n = Math.floor(room / LAYER);
    if (n < 1) { rb.textContent = 'Use plates only'; rs.textContent = 'Base and top plate (4 in) bring the jack within reach.'; res.className = 'result'; return; }
    var h = 2 * PLATE + n * LAYER, gap = lp - cl - h;
    var blocks = 3 * n, wt = Math.round(blocks * 26.5 + 2 * 41.6);
    var capped = false;
    if (h > MAXH) {
      n = Math.floor((MAXH - 2 * PLATE) / LAYER); h = 2 * PLATE + n * LAYER; gap = lp - cl - h; capped = true;
      blocks = 3 * n; wt = Math.round(blocks * 26.5 + 2 * 41.6);
      if (gap >= st) {
        rb.textContent = 'Over the 72 in limit';
        rs.textContent = 'This lift would need a stack taller than 72 in. Keep the crib at 72 in or less and use a jack with at least ' + Math.ceil(lp - h - st) + ' in closed height (with this stroke), or lift from a lower point.';
        res.className = 'result bad'; return;
      }
    }
    rb.textContent = n + ' layers · ' + h + ' in stack';
    rs.textContent = blocks + ' blocks plus base and top plate, about ' + wt + ' lb. The jack starts ' + gap.toFixed(1) + ' in below the lift point, leaving ' + Math.max(0, st - gap).toFixed(1) + ' in of stroke to lift. ' + (capped ? 'Stack held at the 72 in limit, so the jack uses some stroke to reach.' : 'Under the 72 in limit with ' + (MAXH - h) + ' in to spare.');
    res.className = 'result';
  }
  ['inLift', 'inClosed', 'inStroke'].forEach(function (id) { $(id).addEventListener('input', calc); });
  calc();
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Crib lift platform",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A lift point where the ground can't give you one" }
  ],
  "presets": [{ "name": "Crib lift platform" }]
}
{% endschema %}
