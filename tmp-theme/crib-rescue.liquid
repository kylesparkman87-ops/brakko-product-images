{%- liquid
  assign p = closest.product
  if p == blank
    assign p = product
  endif
  assign show = false
  if p != blank and p.type == 'Cribbing Block'
    assign show = true
  endif
  if collection.handle == 'cribbing-blocks' or collection.handle == 'cribbing-kits'
    assign show = true
  endif
-%}
{%- if show -%}
{%- render 'crib-rescue-styles' -%}
<div class="bk-rs" id="bk-rs-{{ block.id }}" {{ block.shopify_attributes }}>
  <h3 class="bk-rs__title">{{ block.settings.heading | escape }}</h3>
  <p class="bk-rs__lede">In heavy rescue, the lifting tool raises the load and the crib holds it. A Brakko box crib follows the load up, so if a bag or jack fails, the load drops onto the crib instead of the patient.</p>
<section class="stage" aria-label="Animated heavy rescue cribbing explainer">
    <svg id="svg-{{ block.id }}" viewBox="0 0 1200 680" role="img" aria-labelledby="svgDesc-{{ block.id }}">
      <desc id="svgDesc-{{ block.id }}">Side view of a heavy load resting on a patient's legs. A box crib of 4 by 4 and 2 by 4 inch blocks is built under the load and a lifting bag raises it. Each time the load rises 2 inches another 2 by 4 layer goes in. When the bag fails mid-lift the load drops about 1 inch onto the crib, while a dashed outline shows the full drop back onto the patient without cribbing. A final panel shows wood cribbing soaking up fluids while plastic wipes clean.</desc>
      <defs>
        <marker id="ah-{{ block.id }}" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="3" markerHeight="3" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="f-hot"/></marker>
        <pattern id="pyr-{{ block.id }}" width="8" height="8" patternUnits="userSpaceOnUse"><rect width="8" height="8" class="f-block"/><rect x="1.4" y="1.4" width="5.2" height="5.2" class="f-block-hi"/></pattern>
      </defs>

      <g id="sceneLift-{{ block.id }}">
        <rect x="0" y="620" width="1200" height="60" class="f-soil"/>
        <g id="grains-{{ block.id }}"></g>
        <g id="person-{{ block.id }}">
          <circle cx="420" cy="584" r="34" class="f-person-dk"/>
          <rect x="452" y="550" width="146" height="70" rx="30" class="f-person"/>
          <rect x="600" y="566" width="175" height="54" rx="22" class="f-person-dk"/>
          <text id="patientTxt-{{ block.id }}" x="430" y="528" class="t-display" font-size="22">Patient</text>
        </g>
        <g id="crib-{{ block.id }}"></g>
        <path id="bag-{{ block.id }}" class="f-bag" d=""/>
        <text id="bagTxt-{{ block.id }}" x="1040" y="612" text-anchor="middle" class="t-display" font-size="16" fill="#1a1a1a">BAG</text>
        <path id="ghost-{{ block.id }}" class="s-ghost" d="" opacity="0"/>
        <g id="ghostTxt-{{ block.id }}" opacity="0"><text x="40" y="372" class="t-display t-hot" font-size="24">Without cribbing:</text><text x="40" y="402" class="t-display t-hot" font-size="24">it falls back onto the patient</text></g>
        <g id="load-{{ block.id }}">
          <rect x="600" y="300" width="1150" height="320" class="f-load"/>
          <line x1="600" y1="360" x2="1750" y2="360" class="s-loaddk" stroke-width="3"/>
          <text x="640" y="345" class="t-display" font-size="24">Heavy load</text>
        </g>
        <g id="gapDim-{{ block.id }}" opacity="0">
          <line x1="948" y1="0" x2="948" y2="0" class="s-hot" stroke-width="3"/>
          <text x="956" y="0" class="t-mono" font-size="18" fill="currentColor">gap</text>
        </g>
        <text id="sceneLabel-{{ block.id }}" x="40" y="54" class="t-display" font-size="30"></text>
        <g id="readout-{{ block.id }}">
          <text id="roLabel-{{ block.id }}" x="40" y="150" class="t-muted" font-size="20" letter-spacing="2"></text>
          <text id="roBig-{{ block.id }}" x="40" y="226" class="t-display" font-size="76"></text>
          <text id="roSub-{{ block.id }}" x="40" y="262" class="t-mono" font-size="19"></text>
          <text id="roNote-{{ block.id }}" x="40" y="306" class="t-display" font-size="28"></text>
        </g>
      </g>

      <g id="sceneClean-{{ block.id }}" opacity="0">
        <text x="40" y="54" class="t-display" font-size="30">After the call</text>
        <text x="40" y="88" class="t-muted" font-size="20">Cribbing that touches fuel, oil or blood has to be cleaned or thrown out.</text>
        <g id="woodSide-{{ block.id }}">
          <rect x="120" y="380" width="380" height="90" rx="4" class="f-wood"/>
          <path d="M140 405 C 240 395, 330 418, 480 402 M140 430 C 260 440, 360 420, 480 436 M140 452 C 230 446, 350 462, 480 450" class="s-woodgrain"/>
          <ellipse id="stain1-{{ block.id }}" cx="250" cy="425" rx="0" ry="0" class="f-stain" opacity="0.75"/>
          <ellipse id="stain2-{{ block.id }}" cx="380" cy="420" rx="0" ry="0" class="f-stain" opacity="0.75"/>
          <g id="dropsW-{{ block.id }}"></g>
          <text x="310" y="530" text-anchor="middle" class="t-display" font-size="28">Wood</text>
          <text id="woodTxt-{{ block.id }}" x="310" y="566" text-anchor="middle" class="t-display t-hot" font-size="24" opacity="0">Soaks it up. Bag it, toss it.</text>
        </g>
        <g id="plasSide-{{ block.id }}">
          <rect x="700" y="380" width="380" height="90" rx="4" fill="url(#pyr-{{ block.id }})"/>
          <rect x="700" y="380" width="380" height="90" rx="4" class="s-blockedge"/>
          <g id="beads-{{ block.id }}"></g>
          <rect id="wipe-{{ block.id }}" x="690" y="360" width="34" height="130" rx="8" class="f-steel" opacity="0"/>
          <text x="890" y="530" text-anchor="middle" class="t-display" font-size="28">Brakko</text>
          <text id="plasTxt-{{ block.id }}" x="890" y="566" text-anchor="middle" class="t-display t-ok" font-size="24" opacity="0">Wipes clean. Back on the rig.</text>
        </g>
      </g>
    </svg>
    <div class="bar">
      <div class="controls">
        <button id="playBtn-{{ block.id }}" type="button" aria-label="Pause">Pause</button>
        <button id="replayBtn-{{ block.id }}" type="button">Replay</button>
      </div>
      <div class="scenes" role="group" aria-label="Jump to scene">
        <button type="button" data-scene="0" aria-pressed="true">Pinned</button>
        <button type="button" data-scene="1" aria-pressed="false">Lift &amp; crib</button>
        <button type="button" data-scene="2" aria-pressed="false">Bag fails</button>
        <button type="button" data-scene="3" aria-pressed="false">Clean-up</button>
      </div>
      <div class="progress" aria-hidden="true"><span id="prog-{{ block.id }}"></span></div>
    </div>
  </section>

  <p class="caption" id="caption-{{ block.id }}" aria-live="polite"></p>

  <h4 class="bk-rs__sub">Build a rescue crib kit</h4>
  <div class="tablewrap">
    <table>
      <thead><tr><th>Block</th><th>Used for</th><th class="num">Rated capacity</th><th class="num">Weight</th></tr></thead>
      <tbody>
        <tr><td>2 × 4 × 18 in (32-020418)</td><td>Shims, closing gaps, topping off a crib as the load rises</td><td class="num">10 ton</td><td class="num">5.2 lb</td></tr>
        <tr><td>4 × 4 × 18 in (32-040418)</td><td>Box cribs for vehicle stabilization and lifts</td><td class="num">20 ton</td><td class="num">8.9 lb</td></tr>
        <tr><td>6 × 7 × 24 in (32-060724)</td><td>Heavy vehicles, buses and machinery</td><td class="num">100 ton</td><td class="num">26.5 lb</td></tr>
        <tr><td>12 × 12 × 6 in (32-121206)</td><td>Crib bases and wide pads on soft ground</td><td class="num">100 ton</td><td class="num">29.8 lb</td></tr>
        <tr><td>12 × 24 × 6 in (32-122406)</td><td>Large crib bases and outrigger pads</td><td class="num">100 ton</td><td class="num">59.6 lb</td></tr>
      </tbody>
    </table>
  </div>
  <ul class="notes">
    <li>Stack shown: a box crib with a 4 × 4 × 18 in base layer and 2 × 4 × 18 in layers added as the load rises, so the crib is never more than 2 in behind the load.</li>
    <li>Rated capacities are per block in the stack configurations in the crib manual. A crib's capacity is set by its weakest layer and how many blocks share the load.</li>
    <li>Keep the crib no taller than 3 × the block length, build on firm ground, and place the crib and lifting tool so neither one sits on the patient.</li>
    <li>Never place hands or any body part under a load held only by a lifting tool. This is an illustration, not a training standard; follow your department's heavy rescue procedures.</li>
  </ul>
</div>
<script>
(function () {
  var SUF = '-{{ block.id }}';
  var WRAP = document.getElementById('bk-rs' + SUF);
  var ROOT = document.getElementById('svg' + SUF);
  if (!ROOT || ROOT.dataset.init) return; ROOT.dataset.init = '1';
  var NS = 'http://www.w3.org/2000/svg';
  var G = 620, PX = 8, PIV = 1700, EDGE = 600, CR = 924, CW = 18 * PX, CL = CR - CW, BAGX = 1040, BAGW = 130;
  var K = (PIV - CR) / (PIV - EDGE);             // crib-edge height / free-edge height
  var START = 6;                                 // load height at the crib edge, inches
  var SCENES = [0, 6000, 20000, 29000, 37500];
  var CAPTIONS = [
    ['Pinned', 'A heavy load has come down on a patient’s legs. Before anything is lifted, a box crib goes in next to the patient, built up snug to the load, and a lifting bag goes in alongside it.'],
    ['Lift an inch, crib an inch', 'The bag lifts and the crib follows. Every 2 in of lift, another 2 × 4 layer goes in, so the crib is never more than a block’s thickness behind. The bag does the lifting; the crib holds the load.'],
    ['If the bag fails', 'Lifting bags, jacks and struts can fail. Halfway up, the bag lets go. The load drops about 1 in onto the crib. Without cribbing it would fall the whole way back onto the patient.'],
    ['After the call', 'Wood cribbing that soaks up fuel, oil or blood usually has to be bagged and thrown out. Brakko plastic blocks don’t absorb fluids, so they wipe clean, can be rinsed and decontaminated, and go back on the rig.']
  ];
  // crib layers: [thickness in, kind] ; first two are built before lifting
  var LAYERS = [[4, 'end'], [2, 'long'], [2, 'end'], [2, 'long'], [2, 'end']];

  function el(tag, attrs, parent) { var e = document.createElementNS(NS, tag); for (var k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; }
  function $(id) { return document.getElementById(id + SUF); }
  function clamp(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
  function ease(x) { x = clamp(x); return x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2; }

  var seed = 5; function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }
  for (var i = 0; i < 120; i++) el('circle', { cx: (rnd() * 1200).toFixed(1), cy: (G + 6 + rnd() * 50).toFixed(1), r: (1 + rnd() * 2).toFixed(1), 'class': 'f-grain', opacity: (0.35 + rnd() * 0.5).toFixed(2) }, $('grains'));

  // crib
  var crib = $('crib'), layerG = [], y = G, base = [];
  LAYERS.forEach(function (L) {
    var g = el('g', {}, crib), h = L[0] * PX, yt = y - h;
    if (L[1] === 'end') {
      [CL, CR - 4 * PX].forEach(function (x) {
        el('rect', { x: x, y: yt, width: 4 * PX, height: h, rx: 2, 'class': 'f-block' }, g);
        el('rect', { x: x + 3, y: yt + 3, width: 4 * PX - 6, height: Math.min(4, h - 6), fill: 'url(#pyr' + SUF + ')' }, g);
      });
      el('rect', { x: CL + 4 * PX, y: yt, width: CW - 8 * PX, height: h, 'class': 'f-slot', opacity: 0.18 }, g);
    } else {
      el('rect', { x: CL, y: yt, width: CW, height: h, rx: 2, fill: 'url(#pyr' + SUF + ')' }, g);
      el('rect', { x: CL, y: yt, width: CW, height: h, rx: 2, 'class': 's-blockedge' }, g);
    }
    base.push(y); y = yt; layerG.push(g);
  });
  function cribTop(n) { var h = 0; for (var k = 0; k < n; k++) h += LAYERS[k][0]; return h; }

  function edgeFromCrib(hc) { return hc / K; }
  function loadAt(x, edgeIn) { return edgeIn * (PIV - x) / (PIV - EDGE); }
  function setLoad(edgeIn) {
    var th = Math.asin(edgeIn * PX / (PIV - EDGE)) * 180 / Math.PI;
    $('load').setAttribute('transform', 'rotate(' + th.toFixed(3) + ' ' + PIV + ' ' + G + ')');
  }
  function bagPath(hIn, burst) {
    var h = Math.max(0.6, hIn) * PX, x0 = BAGX - BAGW / 2, x1 = BAGX + BAGW / 2, bul = burst ? 2 : 6;
    return 'M' + x0 + ' ' + G + ' L' + x1 + ' ' + G + ' C ' + (x1 + bul) + ' ' + (G - h * 0.3) + ', ' + (x1 + bul) + ' ' + (G - h * 0.7) + ', ' + x1 + ' ' + (G - h) +
      ' L' + x0 + ' ' + (G - h) + ' C ' + (x0 - bul) + ' ' + (G - h * 0.7) + ', ' + (x0 - bul) + ' ' + (G - h * 0.3) + ', ' + x0 + ' ' + G + ' Z';
  }
  function ghostPath(edgeIn) {
    var th = Math.asin(edgeIn * PX / (PIV - EDGE));
    var c = Math.cos(th), s = Math.sin(th);
    function R(x, yy) { var dx = x - PIV, dy = yy - G; return (PIV + dx * c - dy * s).toFixed(1) + ' ' + (G + dx * s + dy * c).toFixed(1); }
    return 'M' + R(EDGE, G) + ' L' + R(1300, G) + ' M' + R(EDGE, G) + ' L' + R(EDGE, 300);
  }

  var ro = { l: $('roLabel'), b: $('roBig'), s: $('roSub'), n: $('roNote') };
  function readout(l, b, s, n, cls) { ro.l.textContent = l; ro.b.textContent = b; ro.s.textContent = s; ro.n.textContent = n; ro.n.setAttribute('class', 't-display' + (cls ? ' ' + cls : '')); }

  var LIFT = 6;
  function render(t) {
    var sc = 0; while (sc < 3 && t >= SCENES[sc + 1]) sc++;
    var u = t - SCENES[sc];
    $('sceneLabel').textContent = CAPTIONS[sc][0];
    $('sceneLift').setAttribute('opacity', sc === 3 ? 0 : 1);
    $('sceneClean').setAttribute('opacity', sc === 3 ? 1 : 0);
    var nL = 0, lift = 0, burst = false, ghostOp = 0, gapOp = 0, bagH, bagFail = 0;
    if (sc === 0) {
      nL = u < 1800 ? 0 : u < 3000 ? 1 : 2;
      readout('LOAD ON PATIENT', '0 in', 'crib built snug to the load', u > 3000 ? 'Ready to lift' : '', '');
    } else if (sc === 1) {
      lift = LIFT * ease((u - 800) / 11500);
      nL = 2 + Math.min(3, Math.floor((lift + 0.001) / 2));
      var gap = START + lift - cribTop(nL);
      gapOp = gap > 0.15 ? 1 : 0;
      readout('LIFTED', lift.toFixed(1) + ' in', 'crib gap ' + gap.toFixed(1) + ' in', lift > 5.9 ? 'Patient free' : 'Crib follows the load', lift > 5.9 ? 't-ok' : '');
    } else if (sc === 2) {
      var up = 3 * ease(u / 1800);
      var fail = clamp((u - 3000) / 450);
      nL = 3;                                   // crib at 8 in when the bag lets go
      var hiLift = up, rest = cribTop(3) - START; // 2 in
      lift = fail > 0 ? hiLift - (hiLift - rest) * fail * fail : hiLift;
      burst = u > 3000; bagFail = clamp((u - 3000) / 350);
      ghostOp = clamp((u - 3600) / 600);
      readout(burst ? 'BAG FAILED' : 'LIFTING', burst ? '1 in drop' : up.toFixed(1) + ' in', burst ? 'load lands on the crib' : 'crib gap ' + Math.max(0, START + up - 8).toFixed(1) + ' in', burst && u > 3600 ? 'Patient protected' : '', 't-ok');
    }
    var edge = edgeFromCrib(START + lift);
    setLoad(edge);
    layerG.forEach(function (g, k) { g.setAttribute('opacity', k < nL ? 1 : 0); });
    bagH = loadAt(BAGX, edge);
    if (sc === 0) bagH = u < 1200 ? 0.6 : Math.min(loadAt(BAGX, edgeFromCrib(START)), 0.6 + (u - 1200) / 600);
    if (burst) bagH = 0.6 + (bagH - 0.6) * (1 - bagFail);
    $('bag').setAttribute('d', bagPath(bagH, burst));
    $('bagTxt').setAttribute('opacity', bagH > 2.5 ? 1 : 0);
    $('bagTxt').setAttribute('y', (G - bagH * PX / 2 + 6).toFixed(1));
    var gd = $('gapDim'), gl = gd.querySelector('line'), gt = gd.querySelector('text');
    var yc = G - cribTop(nL) * PX, yl = G - (START + lift) * PX;
    gl.setAttribute('x1', CR + 12); gl.setAttribute('x2', CR + 12); gl.setAttribute('y1', yc); gl.setAttribute('y2', yl);
    gt.setAttribute('x', CR + 20); gt.setAttribute('y', (yc + yl) / 2 + 6);
    gd.setAttribute('opacity', gapOp);
    $('ghost').setAttribute('d', ghostPath(edgeFromCrib(START)));
    $('ghost').setAttribute('opacity', ghostOp);
    $('ghostTxt').setAttribute('opacity', ghostOp);
    $('patientTxt').setAttribute('opacity', sc === 2 && ghostOp > 0 ? 0 : 1);

    if (sc === 3) renderClean(u);
    $('caption').innerHTML = '<strong>' + CAPTIONS[sc][0] + '</strong>' + CAPTIONS[sc][1];
    ROOT.parentNode.parentNode.querySelectorAll('[data-scene]').forEach(function (b) { b.setAttribute('aria-pressed', String(+b.dataset.scene === sc)); });
    $('prog').style.width = (100 * t / SCENES[4]).toFixed(2) + '%';
  }

  // clean-up panel
  var dW = [], dP = [];
  [[200, 0], [290, 300], [380, 600], [250, 900], [420, 1200]].forEach(function (d) { dW.push({ x: d[0], t0: d[1], n: el('path', { 'class': 'f-fluid', d: '' }, $('dropsW')) }); });
  [[780, 0], [870, 300], [960, 600], [830, 900], [1000, 1200]].forEach(function (d) { dP.push({ x: d[0] + 0, t0: d[1], n: el('path', { 'class': 'f-fluid', d: '' }, $('beads')) }); });
  function dropD(x, yy, r) { return 'M' + x + ' ' + (yy - r * 1.8) + ' C ' + (x + r) + ' ' + (yy - r * 0.6) + ', ' + (x + r) + ' ' + (yy + r) + ', ' + x + ' ' + (yy + r) + ' C ' + (x - r) + ' ' + (yy + r) + ', ' + (x - r) + ' ' + (yy - r * 0.6) + ', ' + x + ' ' + (yy - r * 1.8) + ' Z'; }
  function renderClean(u) {
    dW.forEach(function (d) { var k = (u - d.t0) / 700; if (k < 0) { d.n.setAttribute('d', ''); return; } var yy = 180 + 200 * Math.min(1, k); d.n.setAttribute('d', k < 1 ? dropD(d.x, yy, 9) : ''); });
    var s = clamp((u - 700) / 3500);
    $('stain1').setAttribute('rx', 70 * s); $('stain1').setAttribute('ry', 26 * s);
    $('stain2').setAttribute('rx', 55 * clamp((u - 1300) / 3000)); $('stain2').setAttribute('ry', 22 * clamp((u - 1300) / 3000));
    var wipeK = clamp((u - 3600) / 1800);
    dP.forEach(function (d) {
      var k = (u - d.t0) / 700; if (k < 0) { d.n.setAttribute('d', ''); return; }
      var yy = 180 + 200 * Math.min(1, k) - (k >= 1 ? 8 : 0);
      var wx = 700 + wipeK * 400;
      d.n.setAttribute('d', (k >= 1 && wx > d.x) ? '' : dropD(d.x, yy, k >= 1 ? 7 : 9));
    });
    $('wipe').setAttribute('x', 690 + wipeK * 400); $('wipe').setAttribute('opacity', wipeK > 0 && wipeK < 1 ? 0.85 : 0);
    $('woodTxt').setAttribute('opacity', clamp((u - 2600) / 600));
    $('plasTxt').setAttribute('opacity', clamp((u - 5400) / 600));
  }

  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var t = 0, playing = !reduce, last = null;
  function frame(ts) {
    if (last === null) last = ts;
    if (playing) { t += Math.min(ts - last, 100); if (t >= SCENES[4]) t = 0; render(t); }
    last = ts; requestAnimationFrame(frame);
  }
  function setPlay(p) { playing = p; $('playBtn').textContent = p ? 'Pause' : 'Play'; $('playBtn').setAttribute('aria-label', p ? 'Pause' : 'Play'); }
  $('playBtn').addEventListener('click', function () { setPlay(!playing); });
  $('replayBtn').addEventListener('click', function () { t = 0; render(0); setPlay(true); });
  ROOT.parentNode.parentNode.querySelectorAll('[data-scene]').forEach(function (b) {
    b.addEventListener('click', function () { var s = +b.dataset.scene; t = SCENES[s] + [4500, 13500, 5200, 7600][s]; render(t); setPlay(false); });
  });
  setPlay(playing);
  render(reduce ? SCENES[1] + 13500 : 0);
  requestAnimationFrame(frame);
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Crib rescue lift",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lift an inch, crib an inch" }
  ],
  "presets": [{ "name": "Crib rescue lift" }]
}
{% endschema %}
